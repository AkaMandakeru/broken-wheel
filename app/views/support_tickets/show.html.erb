<div class="pt-8 max-w-3xl mx-auto">
  <%= link_to support_tickets_path, class: "text-sm text-gray-500 hover:text-[#FC4C02] flex items-center gap-1 mb-2" do %>
    <i class="fa-solid fa-arrow-left text-xs"></i> <%= t("support.title") %>
  <% end %>

  <div class="flex items-start justify-between gap-3 mb-1">
    <h1 class="text-2xl font-bold text-gray-900"><%= @ticket.subject %></h1>
    <span class="text-xs px-2 py-1 rounded-full whitespace-nowrap <%= status_badge_class(@ticket.status) %>">
      <%= t("support.statuses.#{@ticket.status}") %>
    </span>
  </div>
  <p class="text-sm text-gray-500 mb-6"><%= t("support.categories.#{@ticket.category}") %></p>

  <div class="space-y-3 mb-6">
    <% @messages.each do |message| %>
      <%= render "support_tickets/message", message: message %>
    <% end %>
  </div>

  <% unless @ticket.closed? %>
    <%= form_with url: support_ticket_messages_path(@ticket), scope: :support_message, class: "bg-white rounded-lg shadow-sm border border-gray-200 p-4 space-y-3" do |f| %>
      <%= f.label :body, t("support.show.reply_label"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :body, rows: 3, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      <%= f.submit t("support.show.reply_submit"), class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-500 bg-gray-50 border border-gray-200 rounded-lg p-4"><%= t("support.show.closed_notice") %></p>
  <% end %>
</div>
