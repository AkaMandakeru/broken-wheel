<div class="pt-8 max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("support.title") %></h1>
    <%= link_to new_support_ticket_path, class: "bg-[#FC4C02] text-white px-4 py-2 rounded-lg hover:bg-[#e04402] transition font-medium text-sm flex items-center gap-2" do %>
      <i class="fa-solid fa-plus"></i> <%= t("support.new.title") %>
    <% end %>
  </div>

  <% if @tickets.any? %>
    <div class="space-y-3">
      <% @tickets.each do |ticket| %>
        <%= link_to support_ticket_path(ticket), class: "block bg-white rounded-lg shadow-sm border border-gray-200 p-4 hover:shadow-md transition" do %>
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-medium text-gray-900"><%= ticket.subject %></p>
              <p class="text-xs text-gray-500 mt-1">
                <%= t("support.categories.#{ticket.category}") %> ·
                <%= (ticket.last_message_at || ticket.created_at).strftime("%b %-d, %Y") %>
              </p>
            </div>
            <span class="text-xs px-2 py-1 rounded-full whitespace-nowrap <%= status_badge_class(ticket.status) %>">
              <%= t("support.statuses.#{ticket.status}") %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
      <p class="text-gray-500 mb-4"><%= t("support.index.empty") %></p>
      <%= link_to t("support.new.title"), new_support_ticket_path, class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium" %>
    </div>
  <% end %>
</div>
