<div class="pt-8">
  <%= link_to challenges_path, class: "text-[#FC4C02] hover:underline mb-6 inline-block" do %>
    <%= t('common.buttons.back') %>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= @challenge.display_title %></h1>
    <p class="text-gray-600 mt-2"><%= @challenge.display_description %></p>
    <div class="flex gap-4 mt-4 text-sm text-gray-500">
      <span><%= t("enums.sports.#{@challenge.sport}", default: @challenge.sport&.capitalize.to_s) %></span>
      <span><%= t('challenges.show.target') %>: <%= @challenge.target_value %> <%= t("enums.target_units.#{@challenge.target_unit}", default: @challenge.target_unit.to_s) %></span>
      <span><%= @challenge.starts_at&.strftime("%b %d") %> - <%= @challenge.ends_at&.strftime("%b %d, %Y") %></span>
    </div>

    <div class="flex gap-4 mt-6">
      <% if @participation %>
        <%= link_to challenge_timeline_posts_path(@challenge), class: "text-[#FC4C02] hover:underline font-medium" do %>
          <%= t('challenges.show.timeline') %>
        <% end %>
        <%= link_to t('challenges.invite.invite_friends'), invite_challenge_path(@challenge), class: "text-[#FC4C02] hover:underline font-medium" %>
      <% else %>
        <%= button_to t('challenges.show.join_challenge'), join_challenge_path(@challenge), method: :post, class: "bg-[#FC4C02] text-white px-6 py-2 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <% if @participation %>
    <%= render "shared/progress_bar", participation: @participation, challenge: @challenge %>

    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('challenges.show.ranking') %></h2>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('challenges.show.rank') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('challenges.show.participant') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('challenges.show.progress') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @participations.each_with_index do |p, i| %>
              <tr class="<%= p.user_id == current_user.id ? 'bg-orange-50' : '' %>">
                <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= i + 1 %></td>
                <td class="px-6 py-4 text-sm text-gray-700"><%= p.user.first_name %> <%= p.user.last_name %></td>
                <td class="px-6 py-4 text-sm text-gray-700"><%= p.progress_value %> / <%= @challenge.target_value %> <%= t("enums.target_units.#{@challenge.target_unit}", default: @challenge.target_unit.to_s) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <div class="mt-8">
    <%= render "shared/feedback_button", source: "challenges", label: t("support.help_with.challenges") %>
  </div>
</div>
