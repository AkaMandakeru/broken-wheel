<div class="pt-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t('challenges.index.title') %></h1>

  <% if user_signed_in? %>
    <p class="text-gray-600 mb-6"><%= t('challenges.index.browse_signed_in') %></p>
  <% else %>
    <p class="text-gray-600 mb-6"><%= t('challenges.index.browse_guest') %></p>
    <div class="flex gap-4 mb-8">
      <%= link_to t('challenges.index.sign_up'), new_user_registration_path, class: "bg-[#FC4C02] text-white px-6 py-3 rounded-lg hover:bg-[#e04402] transition font-medium" %>
      <%= link_to t('challenges.index.log_in'), new_user_session_path, class: "border border-gray-300 px-6 py-3 rounded-lg hover:bg-gray-50 transition font-medium" %>
    </div>
  <% end %>

  <%# Current active season %>
  <% if @active_season %>
    <%= link_to season_path(@active_season), class: "block rounded-2xl overflow-hidden bg-white shadow-sm border border-gray-200 hover:shadow-md transition mb-8" do %>
      <div class="h-2 bg-linear-to-r <%= season_theme_classes(@active_season.theme) %>"></div>
      <div class="p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#FC4C02]"><%= t('seasons.index.active') %></span>
            <h2 class="text-xl font-extrabold text-gray-900 mt-1"><%= @active_season.name %></h2>
            <% if @active_season.starts_at && @active_season.ends_at %>
              <p class="text-sm text-gray-500 mt-0.5"><%= @active_season.starts_at.strftime("%b %-d") %> – <%= @active_season.ends_at.strftime("%b %-d, %Y") %></p>
            <% end %>
          </div>
          <i class="fa-solid fa-ranking-star text-2xl text-[#FC4C02]/70 shrink-0"></i>
        </div>

        <% if @season_participation %>
          <% pct = Leveling.progress_percent(@season_participation.xp) %>
          <div class="mt-4">
            <div class="flex justify-between text-xs text-gray-500 mb-1">
              <span class="font-semibold text-gray-700"><%= t('seasons.show.level') %> <%= @season_participation.level %> · <%= @season_participation.xp %> <%= t('seasons.show.xp') %></span>
              <span><%= t('seasons.show.rank') %> #<%= @season_participation.rank %></span>
            </div>
            <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
              <div class="h-full bg-[#FC4C02] rounded-full" style="width: <%= pct %>%"></div>
            </div>
          </div>
        <% else %>
          <p class="text-sm text-gray-600 mt-3"><%= t('challenges.index.season_cta') %> <span class="text-[#FC4C02] font-medium"><%= t('challenges.index.view_season') %> →</span></p>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# Filter by challenge type %>
  <div class="flex flex-wrap gap-2 mb-6 text-sm">
    <%= link_to t('challenges.index.filters.all'), challenges_path,
          class: "px-3 py-1.5 rounded-lg #{@type.nil? ? 'bg-[#FC4C02] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <% Challenge::CHALLENGE_TYPES.each do |type| %>
      <%= link_to t("enums.challenge_types.#{type}", default: type.capitalize), challenges_path(type: type),
            class: "px-3 py-1.5 rounded-lg #{@type == type ? 'bg-[#FC4C02] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <% end %>
  </div>

  <div class="space-y-4">
    <% @challenges.each do |challenge| %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-lg font-semibold text-gray-900"><%= challenge.display_title %></h2>
            <p class="text-sm text-gray-600 mt-1"><%= challenge.display_description %></p>
            <div class="flex gap-4 mt-2 text-sm text-gray-500">
              <span><%= t("enums.sports.#{challenge.sport}", default: challenge.sport&.capitalize.to_s) %></span>
              <span><%= challenge.target_value %> <%= challenge.target_unit %></span>
              <span><%= t("enums.challenge_types.#{challenge.challenge_type}", default: challenge.challenge_type&.capitalize.to_s) %></span>
            </div>
          </div>
          <% if user_signed_in? %>
            <%# Preloaded in the controller — a per-row lookup here would query once per challenge. %>
            <% participation = @my_participations[challenge.id] %>
            <% if participation %>
              <%= link_to t('challenges.index.view'), challenge_path(challenge), class: "bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition font-medium" %>
            <% else %>
              <%= link_to t('challenges.index.join'), challenge_path(challenge), class: "bg-[#FC4C02] text-white px-4 py-2 rounded-lg hover:bg-[#e04402] transition font-medium" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @challenges.empty? %>
    <% if @type %>
      <p class="text-gray-500 py-8"><%= t('challenges.index.none_for_filter') %></p>
    <% else %>
      <p class="text-gray-500 py-8"><%= t('challenges.index.no_challenges') %> <code class="bg-gray-100 px-2 py-1 rounded">bin/rails db:seed</code> <%= t('challenges.index.to_add_sample') %>.</p>
    <% end %>
  <% end %>
</div>
