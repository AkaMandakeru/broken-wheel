<div class="pt-8">
  <%= link_to t('challenges.show.back_to_challenge'), challenge_path(@challenge), class: "text-[#FC4C02] hover:underline mb-6 inline-block" %>

  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t('challenges.invite.invite_friends') %></h1>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
    <p class="text-gray-600 mb-4"><%= t('challenges.invite.share_challenge') %>:</p>
    <div class="flex gap-2">
      <input type="text" value="<%= challenge_url(@challenge) %>" readonly class="form-control flex-1" id="invite-link">
      <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('invite-link').value); alert('<%= t('challenges.invite.copied') %>');" class="btn-primary">
        <%= t('challenges.invite.copy_link') %>
      </button>
    </div>
  </div>

  <p class="text-sm text-gray-500">Share via email, WhatsApp, or Instagram.</p>
</div>
