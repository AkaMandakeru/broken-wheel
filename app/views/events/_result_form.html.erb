<%# locals: event, available_workouts, url, method, submit_label, include_distance (optional) %>
<% if available_workouts&.any? %>
  <%= form_with url: url, method: method, scope: :event_participation, class: "space-y-4" do |f| %>
    <% if local_assigns[:include_distance] %>
      <%= render "distance_radios", event: event, selected: nil %>
    <% end %>
    <div>
      <%= f.label :workout_id, t("events.show.select_workout"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :workout_id,
            workout_options_for(available_workouts),
            { include_blank: t("events.show.select_workout_blank") },
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :bib_number, t("events.show.bib"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :bib_number, value: local_assigns[:bib_number], class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>
    </div>
    <div>
      <%= f.label :notes, t("events.show.notes"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notes, rows: 2, value: local_assigns[:notes], class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    </div>
    <%= f.submit submit_label, class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
  <% end %>
<% else %>
  <p class="text-sm text-gray-600">
    <%= t("events.show.no_workouts") %>
    <%= link_to t("events.show.import_strava"), workouts_path, class: "text-[#FC4C02] hover:underline font-medium" %>
  </p>
<% end %>
