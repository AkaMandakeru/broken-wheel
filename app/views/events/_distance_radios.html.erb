<%# locals: event, selected (optional) — renders distance choices for an event_participation form %>
<% if event.distances.present? %>
  <fieldset>
    <legend class="block text-sm font-medium text-gray-700 mb-2"><%= t("events.show.choose_distance") %></legend>
    <div class="flex flex-wrap gap-2">
      <% event.distances.each do |d| %>
        <label class="inline-flex items-center gap-2 px-3 py-2 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
          <%= radio_button_tag "event_participation[selected_distance_km]", d, local_assigns[:selected].to_f == d.to_f, class: "text-[#FC4C02] focus:ring-[#FC4C02]" %>
          <span class="text-sm font-medium text-gray-800"><%= format_km(d) %> km</span>
        </label>
      <% end %>
    </div>
  </fieldset>
<% end %>
