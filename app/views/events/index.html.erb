<div class="pt-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= t("events.index.title") %></h1>
  <p class="text-gray-600 mb-6"><%= t("events.index.subtitle") %></p>

  <% if @upcoming_events.any? %>
    <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= t("events.index.upcoming") %></h2>
    <div class="space-y-4 mb-10">
      <% @upcoming_events.each do |event| %>
        <%= render "event_card", event: event %>
      <% end %>
    </div>
  <% end %>

  <% if @past_events.any? %>
    <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= t("events.index.past") %></h2>
    <div class="space-y-4">
      <% @past_events.each do |event| %>
        <%= render "event_card", event: event %>
      <% end %>
    </div>
  <% end %>

  <% if @upcoming_events.empty? && @past_events.empty? %>
    <p class="text-gray-500 py-8"><%= t("events.index.empty") %></p>
  <% end %>
</div>
