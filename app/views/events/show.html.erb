<div class="pt-8">
  <%= link_to events_path, class: "text-sm text-gray-500 hover:text-[#FC4C02] flex items-center gap-1 mb-3" do %>
    <i class="fa-solid fa-arrow-left text-xs"></i> <%= t("events.show.back") %>
  <% end %>

  <%# Header %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden mb-6">
    <% if @event.image.attached? %>
      <%= image_tag @event.image.variant(resize_to_limit: [1000, 360]), class: "w-full h-48 sm:h-60 object-cover" %>
    <% end %>
    <div class="p-6">
      <div class="flex items-start justify-between">
        <h1 class="text-2xl font-bold text-gray-900"><%= @event.title %></h1>
        <span class="text-xs px-2 py-1 rounded-full <%= @event.upcoming? ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
          <%= t("events.statuses.#{@event.status}", default: @event.status.to_s.capitalize) %>
        </span>
      </div>
      <p class="mt-2 text-sm font-medium text-gray-700">
        <i class="fa-solid fa-user-group text-[#FC4C02] mr-1"></i>
        <%= t("events.show.going_count", count: @event.event_participations_count) %>
      </p>
      <% if @event.description.present? %>
        <p class="text-gray-600 mt-2"><%= @event.description %></p>
      <% end %>
      <div class="flex-wrap gap-x-5 gap-y-1 mt-4 text-sm text-gray-500">
        <% if @event.event_date %>
          <p><i class="fa-solid fa-calendar-day mr-1"></i> <%= @event.event_date.strftime("%b %-d, %Y · %H:%M") %></p>
        <% end %>
        <% if @event.location.present? %>
          <p><i class="fa-solid fa-location-dot mr-1"></i> <%= @event.location %></p>
        <% end %>
        <% if @event.sport.present? %>
          <p><i class="fa-solid fa-person-running mr-1"></i> <%= t("enums.sports.#{@event.sport}", default: @event.sport.capitalize) %></p>
        <% end %>
        <% if event_distances_label(@event) %>
          <p><i class="fa-solid fa-ruler-horizontal mr-1"></i> <%= event_distances_label(@event) %></p>
        <% end %>
      </div>

      <% if @event.distances.present? %>
        <div class="flex flex-wrap gap-2 mt-4">
          <% @event.distances.each do |d| %>
            <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-700">
              <span class="font-semibold"><%= format_km(d) %> km</span>
              <span class="text-gray-400">·</span>
              <%= t("events.show.distance_going_count", count: @distance_counts[d] || 0) %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Participation panel %>
  <% if user_signed_in? %>
    <% if @participation&.completed? %>
      <%# Already recorded a result %>
      <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between">
          <div>
            <p class="font-semibold text-green-800 mb-1">
              <i class="fa-solid fa-circle-check mr-1"></i><%= t("events.show.you_participated") %>
              <% if @participation.selected_distance_km %>
                <span class="ml-1 text-sm font-medium text-green-700">· <%= format_km(@participation.selected_distance_km) %> km</span>
              <% end %>
            </p>
            <div class="flex flex-wrap gap-x-5 gap-y-1 mt-2 text-sm text-gray-700">
              <span><strong><%= @participation.distance_km %></strong> km</span>
              <span><strong><%= format_duration_minutes(@participation.duration_minutes) %></strong></span>
              <% if @participation.pace_per_km %>
                <span><strong><%= format_pace(@participation.pace_per_km) %></strong></span>
              <% end %>
            </div>
            <% if @participation.bib_number.present? %>
              <p class="text-sm text-gray-600 mt-1"><%= t("events.show.bib") %>: <%= @participation.bib_number %></p>
            <% end %>
            <% if @participation.notes.present? %>
              <p class="text-sm text-gray-600 mt-1"><%= @participation.notes %></p>
            <% end %>
          </div>
          <%= button_to t("events.show.remove"), event_participation_path(@event), method: :delete,
                form: { data: { turbo_confirm: t("events.show.confirm_remove") } },
                class: "text-sm text-red-600 hover:text-red-800 cursor-pointer" %>
        </div>
      </div>
    <% elsif @participation&.going? %>
      <%# RSVP'd, but no result yet — let them add it %>
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
        <div class="flex items-start justify-between mb-4">
          <p class="font-semibold text-blue-800">
            <i class="fa-solid fa-circle-check mr-1"></i><%= t("events.show.youre_going") %>
            <% if @participation.selected_distance_km %>
              <span class="ml-1 text-sm font-medium text-blue-700">· <%= format_km(@participation.selected_distance_km) %> km</span>
            <% end %>
          </p>
          <%= button_to t("events.show.cancel_rsvp"), event_participation_path(@event), method: :delete,
                form: { data: { turbo_confirm: t("events.show.confirm_cancel") } },
                class: "text-sm text-red-600 hover:text-red-800 cursor-pointer" %>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1"><%= t("events.show.add_result_title") %></h3>
        <p class="text-sm text-gray-600 mb-4"><%= t("events.show.add_result_subtitle") %></p>
        <%= render "result_form",
              event: @event,
              available_workouts: @available_workouts,
              url: event_participation_path(@event),
              method: :patch,
              submit_label: t("events.show.add_result_submit") %>
      </div>
    <% else %>
      <%# Not participating yet — RSVP, or record a past result directly %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
        <% if @event.upcoming? %>
          <h2 class="text-lg font-semibold text-gray-900 mb-1"><%= t("events.show.join_title") %></h2>
          <p class="text-sm text-gray-600 mb-4"><%= t("events.show.join_subtitle") %></p>
          <% if @event.distances.present? %>
            <%= form_with url: event_participation_path(@event), method: :post, scope: :event_participation, class: "space-y-4" do %>
              <%= render "distance_radios", event: @event, selected: nil %>
              <button type="submit" class="bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer flex items-center gap-2 w-full sm:w-auto justify-center">
                <i class="fa-solid fa-hand"></i> <%= t("events.show.rsvp") %>
              </button>
            <% end %>
          <% else %>
            <%= button_to event_participation_path(@event), method: :post,
                  class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer flex items-center gap-2 w-full sm:w-auto justify-center" do %>
              <i class="fa-solid fa-hand"></i> <%= t("events.show.rsvp") %>
            <% end %>
          <% end %>

          <div class="mt-5 pt-5 border-t border-gray-100">
            <h3 class="text-sm font-semibold text-gray-900 mb-1"><%= t("events.show.already_done_title") %></h3>
            <p class="text-sm text-gray-600 mb-4"><%= t("events.show.already_done_subtitle") %></p>
            <%= render "result_form",
                  event: @event,
                  available_workouts: @available_workouts,
                  url: event_participation_path(@event),
                  method: :post,
                  include_distance: true,
                  submit_label: t("events.show.record_submit") %>
          </div>
        <% else %>
          <h2 class="text-lg font-semibold text-gray-900 mb-1"><%= t("events.show.record_title") %></h2>
          <p class="text-sm text-gray-600 mb-4"><%= t("events.show.record_subtitle") %></p>
          <%= render "result_form",
                event: @event,
                available_workouts: @available_workouts,
                url: event_participation_path(@event),
                method: :post,
                include_distance: true,
                submit_label: t("events.show.record_submit") %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6 text-center">
      <p class="text-gray-600 mb-3"><%= t("events.show.sign_in_prompt") %></p>
      <%= link_to t("events.show.sign_in"), new_user_session_path, class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium" %>
    </div>
  <% end %>

  <%# Results %>
  <h2 class="text-lg font-semibold text-gray-900 mb-3">
    <%= t("events.show.results", count: @participations.size) %>
  </h2>
  <% if @participations.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("events.show.athlete") %></th>
            <% if @event.distances.present? %>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("events.show.category") %></th>
            <% end %>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("events.show.distance") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("events.show.time") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("events.show.pace") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @participations.each do |p| %>
            <tr>
              <td class="px-4 py-3 text-sm font-medium text-gray-900">
                <%= p.user.first_name %> <%= p.user.last_name %>
                <% if p.going? %>
                  <span class="ml-1 text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 align-middle"><%= t("events.show.going_badge") %></span>
                <% end %>
              </td>
              <% if @event.distances.present? %>
                <td class="px-4 py-3 text-sm text-gray-600"><%= p.selected_distance_km ? "#{format_km(p.selected_distance_km)} km" : "—" %></td>
              <% end %>
              <td class="px-4 py-3 text-sm text-gray-600"><%= p.distance_km ? "#{p.distance_km} km" : "—" %></td>
              <td class="px-4 py-3 text-sm text-gray-600"><%= format_duration_minutes(p.duration_minutes) %></td>
              <td class="px-4 py-3 text-sm text-gray-600"><%= format_pace(p.pace_per_km) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500 py-6"><%= t("events.show.no_results") %></p>
  <% end %>

  <div class="mt-8">
    <%= render "shared/feedback_button", source: "events", label: t("support.help_with.events") %>
  </div>
</div>
