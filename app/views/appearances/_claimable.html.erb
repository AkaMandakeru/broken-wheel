<%# A cosmetic the season is offering. Not owned yet, but one press away — so it
    leads the locker rather than sitting greyed out with the locked ones.
    locals: cosmetic, reward, kind %>
<%= button_to claim_profile_appearance_path,
      method: :post,
      params: { kind: kind, key: cosmetic.key },
      form: { class: "contents" },
      class: "block w-full text-left bg-white rounded-xl overflow-hidden border-2 border-secondary hover:shadow-md transition cursor-pointer" do %>
  <span class="relative block">
    <%= render "appearances/swatch", cosmetic: cosmetic, kind: kind %>
    <span class="absolute top-2 right-2 inline-flex items-center gap-1 text-[10px] font-bold px-2 py-1 rounded-full bg-secondary text-white">
      <i class="fa-solid fa-gift"></i><%= t("appearances.show.claim") %>
    </span>
  </span>

  <span class="block p-2.5">
    <span class="block text-[13px] font-semibold text-gray-900 truncate"><%= cosmetic.display_name %></span>
    <span class="flex flex-wrap items-center gap-1.5 mt-1">
      <%= cosmetic_rarity_chip(cosmetic) %>
    </span>
    <span class="block text-[11px] text-gray-500 mt-1 truncate"><%= reward.season.name %></span>
  </span>
<% end %>
