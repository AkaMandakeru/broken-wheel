<%# One season's medal, with what it took to get there and what the next tier
    still costs. locals: participation, linked %>
<% season = participation.season %>
<% tier   = participation.medal_tier %>
<% cover  = season_image_source(season, resize: [ 400, 160 ]) %>
<% card_class = "block bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden" %>

<% body = capture do %>
  <% if cover %>
    <%= image_tag cover, alt: season.name, class: "h-24 w-full object-cover" %>
  <% else %>
    <div class="h-2 bg-linear-to-r <%= season_theme_classes(season.theme) %>"></div>
  <% end %>

  <div class="p-5">
    <div class="flex items-start gap-3">
      <span class="text-4xl leading-none <%= "opacity-30 grayscale" if tier.blank? %>">
        <%= medal_tier_emoji(tier) %>
      </span>
      <div class="flex-1 min-w-0">
        <p class="font-bold text-gray-900 truncate"><%= season.name %></p>
        <p class="text-xs text-gray-500">
          <%= season.ends_at&.strftime("%b %Y") %>
        </p>
        <div class="mt-1">
          <% if tier %>
            <%= medal_chip(tier) %>
          <% else %>
            <span class="text-xs text-gray-400"><%= t("achievements.index.no_medal_yet") %></span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-2 mt-4 text-center">
      <div>
        <p class="text-sm font-bold text-gray-900"><%= participation.level %></p>
        <p class="text-[11px] text-gray-500"><%= t("seasons.show.level") %></p>
      </div>
      <div>
        <p class="text-sm font-bold text-gray-900"><%= participation.completion_percent %>%</p>
        <p class="text-[11px] text-gray-500"><%= t("seasons.stats.completion") %></p>
      </div>
      <div>
        <p class="text-sm font-bold text-gray-900"><%= participation.medal_fragments %></p>
        <p class="text-[11px] text-gray-500"><%= t("seasons.stats.fragments") %></p>
      </div>
    </div>

    <%# Progress towards the next tier, not towards diamond — see
        SeasonParticipation#medal_progress_percent for why. %>
    <div class="mt-4">
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div class="h-full bg-primary rounded-full" style="width: <%= participation.medal_progress_percent %>%"></div>
      </div>
      <p class="text-[11px] text-gray-500 mt-1">
        <% if participation.next_medal_tier %>
          <%= t("achievements.index.fragments_to_next",
                count: participation.fragments_to_next_medal,
                medal: medal_label(participation.next_medal_tier)) %>
        <% else %>
          <%= t("achievements.index.top_medal") %>
        <% end %>
      </p>
    </div>
  </div>
<% end %>

<% if linked %>
  <%= link_to season_path(season), class: "#{card_class} hover:shadow-md transition" do %><%= body %><% end %>
<% else %>
  <div class="<%= card_class %>"><%= body %></div>
<% end %>
