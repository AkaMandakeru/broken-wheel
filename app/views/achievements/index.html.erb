<% content_for :title, t('achievements.index.title') %>

<div class="pt-8">

  <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= t('achievements.index.heading') %></h1>
  <p class="text-gray-500 text-sm mb-6"><%= t('achievements.index.subtitle') %></p>

  <% if @participations.any? %>
    <%# Summary %>
    <div class="grid grid-cols-3 gap-4 mb-10">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <p class="text-2xl font-bold text-gray-900"><%= @participations.size %></p>
        <p class="text-xs text-gray-500 mt-1"><%= t('achievements.index.seasons_played') %></p>
      </div>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <p class="text-2xl font-bold text-primary"><%= @medals.size %></p>
        <p class="text-xs text-gray-500 mt-1"><%= t('achievements.index.medals_earned') %></p>
      </div>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 text-center">
        <p class="text-2xl font-bold text-gray-400"><%= @participations.sum(&:medal_fragments) %></p>
        <p class="text-xs text-gray-500 mt-1"><%= t('seasons.stats.fragments') %></p>
      </div>
    </div>

    <%# Medals by tier — the shelf, in ladder order rather than by season %>
    <% if @medal_counts.any? %>
      <div class="flex flex-wrap gap-3 mb-10">
        <% SeasonParticipation::MEDAL_TIERS.keys.reverse.each do |tier| %>
          <% next unless @medal_counts[tier].to_i.positive? %>
          <div class="flex items-center gap-2 bg-white rounded-lg border border-gray-200 px-4 py-2">
            <span class="text-2xl"><%= medal_tier_emoji(tier) %></span>
            <div>
              <p class="text-sm font-bold text-gray-900"><%= @medal_counts[tier] %>&times;</p>
              <p class="text-[11px] text-gray-500"><%= medal_label(tier) %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# One card per season taken part in %>
    <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('achievements.index.your_seasons') %></h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-10">
      <% @participations.each do |participation| %>
        <%= render "achievements/medal_card",
              participation: participation,
              linked: @browsable_season_ids.include?(participation.season_id) %>
      <% end %>
    </div>

    <%# Extras the seasons handed out alongside their medals %>
    <% if @reward_badges.any? %>
      <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('achievements.index.season_rewards') %></h2>
      <div class="flex flex-wrap gap-4">
        <% @reward_badges.each do |user_badge| %>
          <div class="bg-white rounded-lg border border-gray-200 p-4 text-center min-w-[110px]">
            <span class="text-3xl"><%= user_badge.badge.icon %></span>
            <p class="text-sm font-medium text-gray-900 mt-2"><%= user_badge.badge.display_name %></p>
            <p class="text-xs text-gray-500"><%= user_badge.earned_at&.strftime("%b %Y") %></p>
          </div>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-10 text-center">
      <p class="text-5xl mb-3">🎖</p>
      <p class="text-gray-900 font-semibold mb-1"><%= t('achievements.index.empty_title') %></p>
      <p class="text-gray-500 text-sm mb-5"><%= t('achievements.index.empty_body') %></p>
      <%= link_to t('achievements.index.browse_seasons'), seasons_path,
            class: "inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg font-medium text-sm hover:opacity-90 transition" %>
    </div>
  <% end %>

</div>
