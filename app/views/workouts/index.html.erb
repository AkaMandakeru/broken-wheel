<div class="pt-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t('workouts.index.title') %></h1>
    <% if @strava_connected %>
      <%= link_to strava_activities_workouts_path, class: "btn-primary inline-flex items-center gap-2" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <%= t('workouts.index.browse_strava') %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 gap-4 mb-8">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500"><%= t('workouts.index.title') %></p>
      <p class="text-2xl font-bold text-gray-900"><%= @workout_count %></p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500"><%= t('workouts.index.days_active') %></p>
      <p class="text-2xl font-bold text-gray-900"><%= @unique_days %></p>
    </div>
  </div>

  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('workouts.index.active_challenges') %></h2>
  <div class="space-y-4 mb-8">
    <% @participations.each do |participation| %>
      <%= render "shared/progress_bar", participation: participation, challenge: participation.challenge, title: participation.challenge.title %>
    <% end %>
    <% if @participations.empty? %>
      <p class="text-gray-500"><%= t('workouts.index.no_active_challenges') %> <%= link_to t('workouts.index.join_challenge'), challenges_path, class: "text-[#FC4C02] hover:underline" %>.</p>
    <% end %>
  </div>

  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('workouts.index.add_workout') %></h2>
  <%= form_with model: Workout.new, url: workouts_path, local: true, html: { class: "bg-white dark:bg-neutral-800 border border-black/10 dark:border-white/10 rounded-xl shadow-sm p-6 mb-8 max-w-md" } do |f| %>
    <div class="space-y-5">
      <div class="relative gap-y-1.5">
        <%= f.label :sport, t('workouts.index.sport'), class: "form-label" %>
        <%= f.select :sport, [[t('enums.sports.run'), "run"], [t('enums.sports.bike'), "bike"]], { include_blank: t('workouts.index.select_sport') }, class: "form-control" %>
      </div>
      <div class="relative gap-y-1.5">
        <%= f.label :workout_date, t('workouts.index.workout_date'), class: "form-label" %>
        <%= f.date_field :workout_date, value: Date.current, class: "form-control" %>
      </div>
      <div class="relative gap-y-1.5">
        <label class="form-label"><%= t('workouts.index.distance') %></label>
        <div class="flex gap-2">
          <%= f.number_field :distance_km_input, min: 0, class: "form-control", placeholder: "km" %>
          <%= f.number_field :distance_m_input, min: 0, max: 999, class: "form-control", placeholder: "m" %>
        </div>
      </div>
      <div class="relative gap-y-1.5">
        <label class="form-label"><%= t('workouts.index.duration') %></label>
        <div class="flex gap-2">
          <%= f.number_field :duration_hours_input, min: 0, class: "form-control", placeholder: "hrs" %>
          <%= f.number_field :duration_minutes_input, min: 0, max: 59, class: "form-control", placeholder: "min" %>
          <%= f.number_field :duration_seconds_input, min: 0, max: 59, class: "form-control", placeholder: "sec" %>
        </div>
      </div>
      <div class="relative gap-y-1.5">
        <%= f.label :challenge_participation_id, t('workouts.index.count_toward_challenge'), class: "form-label" %>
        <%= f.collection_select :challenge_participation_id, @participations || [], :id, ->(p) { p.challenge.title }, { include_blank: t('workouts.index.none') }, class: "form-control" %>
      </div>
      <div class="pt-2">
        <%= f.submit t('workouts.index.add_workout'), class: "btn-primary w-full" %>
      </div>
    </div>
  <% end %>

  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('workouts.index.recent_workouts') %></h2>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <% if @workouts.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('workouts.index.date') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('workouts.index.sport') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('workouts.index.distance') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('workouts.index.duration') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('workouts.index.pace') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('workouts.index.source') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @workouts.each do |w| %>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-900"><%= w.workout_date.strftime("%b %d, %Y") %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= t("enums.sports.#{w.sport}", default: w.sport&.capitalize.to_s) %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= w.distance_km %> km</td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= w.duration_minutes %> min</td>
              <td class="px-6 py-4 text-sm text-gray-700">
                <% if w.distance_km.to_f > 0 && w.duration_minutes.to_f > 0 %>
                  <% pace = w.duration_minutes.to_f / w.distance_km.to_f %>
                  <% pace_min = pace.floor %>
                  <% pace_sec = ((pace - pace_min) * 60).round %>
                  <%= format("%d:%02d /km", pace_min, pace_sec) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700">
                <% if w.provider == "strava" %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-700">Strava</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Manual</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="p-6 text-gray-500"><%= t('workouts.index.no_workouts') %></p>
    <% end %>
  </div>
</div>
