<div class="pt-8 max-w-4xl">
  <%= link_to admin_seasons_path, class: "text-sm text-gray-500 hover:text-[#FC4C02] flex items-center gap-1 mb-2" do %>
    <i class="fa-solid fa-arrow-left text-xs"></i> <%= t("admin.seasons.title") %>
  <% end %>

  <div class="flex items-start justify-between gap-3 mb-1">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.season_imports.title") %></h1>
    <%= link_to template_admin_season_imports_path, class: "shrink-0 inline-flex items-center gap-1.5 border border-gray-300 px-3 py-2 rounded-lg hover:bg-gray-50 transition text-sm font-medium" do %>
      <i class="fa-solid fa-download"></i> <%= t("admin.season_imports.download_template") %>
    <% end %>
  </div>
  <p class="text-sm text-gray-500 mb-6"><%= t("admin.season_imports.subtitle") %></p>

  <%# Validation results — errors block the import, warnings do not. %>
  <% if @validation %>
    <% if @validation.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-4 mb-5">
        <p class="text-sm font-semibold text-red-800 mb-2">
          <i class="fa-solid fa-circle-xmark mr-1"></i>
          <%= t("admin.season_imports.errors.found", count: @validation.errors.size) %>
        </p>
        <ul class="space-y-1 text-xs text-red-700 font-mono">
          <% @validation.errors.each do |message| %>
            <li>· <%= message %></li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="rounded-lg border border-green-200 bg-green-50 p-4 mb-5">
        <p class="text-sm font-semibold text-green-800 mb-2">
          <i class="fa-solid fa-circle-check mr-1"></i><%= t("admin.season_imports.valid") %>
        </p>
        <p class="text-xs text-green-700">
          <% @validation.summary.each do |label, count| %>
            <span class="mr-3"><%= t("admin.season_imports.counts.#{label}", default: label.to_s.humanize) %>: <strong><%= count %></strong></span>
          <% end %>
        </p>
      </div>
    <% end %>

    <% if @validation.warnings.any? %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-5">
        <p class="text-sm font-semibold text-amber-800 mb-2">
          <i class="fa-solid fa-triangle-exclamation mr-1"></i><%= t("admin.season_imports.warnings") %>
        </p>
        <ul class="space-y-1 text-xs text-amber-700 font-mono">
          <% @validation.warnings.each do |message| %>
            <li>· <%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%# turbo: false — "Validate only" answers a POST with a 200 render, and Turbo
      drops those unless they redirect, so the button would silently do nothing.
      A plain browser submit makes both buttons behave the same, and Turbo buys
      this file-upload form nothing. %>
  <%= form_with url: admin_season_imports_path, method: :post, multipart: true,
                data: { turbo: false }, class: "space-y-6" do %>
    <%# 1 — start from a season that already exists %>
    <% if @blueprints.any? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="text-sm font-semibold text-gray-900 mb-1"><%= t("admin.season_imports.bundled.title") %></h2>
        <p class="text-xs text-gray-500 mb-3"><%= t("admin.season_imports.bundled.hint") %></p>
        <div class="space-y-2">
          <% @blueprints.each do |blueprint| %>
            <label class="flex items-center gap-3 rounded-lg border border-gray-200 px-3 py-2 cursor-pointer hover:bg-gray-50">
              <input type="radio" name="blueprint_key" value="<%= blueprint[:key] %>" class="text-[#FC4C02]">
              <span class="flex-1 min-w-0">
                <span class="text-sm font-medium text-gray-900"><%= blueprint[:name].presence || blueprint[:key] %></span>
                <span class="block text-xs text-gray-400 font-mono"><%= blueprint[:key] %></span>
              </span>
              <% if blueprint[:imported] %>
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 whitespace-nowrap">
                  <%= t("admin.season_imports.bundled.already_imported") %>
                </span>
              <% end %>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# 2 — upload a file %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-1"><%= t("admin.season_imports.upload.title") %></h2>
      <p class="text-xs text-gray-500 mb-3"><%= t("admin.season_imports.upload.hint") %></p>
      <input type="file" name="file" accept=".yml,.yaml,text/yaml"
             class="block w-full text-sm text-gray-600 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-900 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-gray-700 file:cursor-pointer">
    </div>

    <%# 3 — paste it %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-1"><%= t("admin.season_imports.paste.title") %></h2>
      <p class="text-xs text-gray-500 mb-3"><%= t("admin.season_imports.paste.hint") %></p>
      <textarea name="content" rows="16" spellcheck="false"
                placeholder="key: my_season_2026_09&#10;name: My Season&#10;starts_at: 2026-09-01&#10;ends_at: 2026-09-30"
                class="block w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-xs leading-relaxed focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none"><%= @content %></textarea>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%# No `value:` — submit_tag's first argument is the label, and passing a
          value would replace it. The label itself is what gets submitted, which
          is all the controller's presence check needs. %>
      <%= submit_tag t("admin.season_imports.validate"), name: "validate_only",
                     class: "border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition font-medium text-sm cursor-pointer" %>
      <%= submit_tag t("admin.season_imports.import"), name: nil,
                     class: "bg-[#FC4C02] text-white px-5 py-2 rounded-lg hover:bg-[#e04402] transition font-medium text-sm cursor-pointer" %>
      <p class="text-xs text-gray-400"><%= t("admin.season_imports.idempotent_hint") %></p>
    </div>
  <% end %>
</div>
