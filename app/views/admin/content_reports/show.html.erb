<div class="pt-8 max-w-3xl mx-auto">
  <%= link_to admin_content_reports_path, class: "text-sm text-gray-500 hover:text-[#FC4C02] flex items-center gap-1 mb-2" do %>
    <i class="fa-solid fa-arrow-left text-xs"></i> <%= t("admin.content_reports.title") %>
  <% end %>

  <div class="flex items-start justify-between gap-3 mb-1">
    <h1 class="text-2xl font-bold text-gray-900">
      <%= t("admin.content_reports.types.#{@report.api_reportable_type}") %> · <%= t("admin.content_reports.reasons.#{@report.reason}") %>
    </h1>
    <span class="text-xs px-2 py-1 rounded-full whitespace-nowrap <%= content_report_badge_class(@report.status) %>">
      <%= t("admin.content_reports.statuses.#{@report.status}") %>
    </span>
  </div>
  <p class="text-sm text-gray-500 mb-6">
    <%= t("admin.content_reports.reported_by", name: content_report_user_name(@report.reporter), date: @report.created_at.strftime("%b %-d, %Y %H:%M")) %>
    <% if @report.resolved_at %>
      · <%= t("admin.content_reports.resolved_by", name: content_report_user_name(@report.resolved_by), date: @report.resolved_at.strftime("%b %-d, %Y %H:%M")) %>
    <% end %>
  </p>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6 space-y-4">
    <div>
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1"><%= t("admin.content_reports.fields.content") %></h2>
      <% if @report.reportable %>
        <p class="text-gray-800 whitespace-pre-wrap"><%= @report.reportable_excerpt %></p>
        <% if @report.reportable.is_a?(TimelinePost) && @report.reportable.images.attached? %>
          <div class="flex gap-2 mt-3 flex-wrap">
            <% @report.reportable.images.each do |image| %>
              <%= image_tag url_for(image), class: "rounded-lg max-h-32 object-cover" %>
            <% end %>
          </div>
        <% end %>
        <% if @report.reportable.is_a?(Club) %>
          <%= link_to t("admin.content_reports.view_club"), club_path(@report.reportable), class: "text-sm text-[#FC4C02] hover:underline" %>
        <% end %>
      <% else %>
        <p class="text-gray-500 italic"><%= t("admin.content_reports.removed_content") %></p>
      <% end %>
    </div>

    <div>
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1"><%= t("admin.content_reports.fields.reported_user") %></h2>
      <p class="text-gray-800">
        <%= content_report_user_name(@report.reported_user) %>
        <% if @report.reported_user %><span class="text-gray-500">(<%= @report.reported_user.email %>)</span><% end %>
      </p>
    </div>

    <% if @report.details.present? %>
      <div>
        <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1"><%= t("admin.content_reports.fields.details") %></h2>
        <p class="text-gray-800 whitespace-pre-wrap"><%= @report.details %></p>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-3 mb-8">
    <% if @report.open? %>
      <%= button_to t("admin.content_reports.actions.dismiss"), admin_content_report_path(@report), method: :patch,
            params: { content_report: { status: "dismissed" } },
            class: "bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition font-medium cursor-pointer" %>
      <%= button_to t("admin.content_reports.actions.action"), admin_content_report_path(@report), method: :patch,
            params: { content_report: { status: "actioned" } },
            class: "bg-[#FC4C02] text-white px-4 py-2 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
    <% else %>
      <%= button_to t("admin.content_reports.actions.reopen"), admin_content_report_path(@report), method: :patch,
            params: { content_report: { status: "open" } },
            class: "bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition font-medium cursor-pointer" %>
    <% end %>
    <% if @report.removable? %>
      <%= button_to t("admin.content_reports.actions.remove_content"), admin_content_report_path(@report), method: :patch,
            params: { remove_content: "1" }, form: { data: { turbo_confirm: t("admin.content_reports.actions.remove_confirm") } },
            class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition font-medium cursor-pointer" %>
    <% end %>
  </div>

  <% if @related_reports.any? %>
    <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= t("admin.content_reports.related", count: @related_reports.size) %></h2>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 divide-y divide-gray-100">
      <% @related_reports.each do |report| %>
        <%= link_to admin_content_report_path(report), class: "flex items-center justify-between px-4 py-3 hover:bg-gray-50" do %>
          <span class="text-sm text-gray-700">
            <%= content_report_user_name(report.reporter) %> · <%= t("admin.content_reports.reasons.#{report.reason}") %>
          </span>
          <span class="text-xs px-2 py-1 rounded-full <%= content_report_badge_class(report.status) %>"><%= t("admin.content_reports.statuses.#{report.status}") %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
