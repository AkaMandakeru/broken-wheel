<div class="pt-8">
  <div class="mb-6">
    <%= link_to admin_season_path(@season), class: "text-sm text-gray-500 hover:text-[#FC4C02] flex items-center gap-1 mb-2" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> <%= @season.name %>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.seasons.edit") %></h1>
  </div>
  <%= render "form", season: @season %>
</div>
