<div class="pt-8">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.seasons.title") %></h1>
    <div class="flex items-center gap-2">
      <%= link_to new_admin_season_import_path, class: "border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition font-medium text-sm flex items-center gap-2" do %>
        <i class="fa-solid fa-file-import"></i> <%= t("admin.season_imports.action") %>
      <% end %>
      <%= link_to new_admin_season_path, class: "bg-[#FC4C02] text-white px-4 py-2 rounded-lg hover:bg-[#e04402] transition font-medium text-sm flex items-center gap-2" do %>
        <i class="fa-solid fa-plus"></i> <%= t("admin.seasons.new") %>
      <% end %>
    </div>
  </div>

  <% if @seasons.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.seasons.fields.name") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.seasons.fields.dates") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.seasons.fields.status") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.seasons.fields.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @seasons.each do |season| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3"><%= link_to season.name, admin_season_path(season), class: "font-medium text-gray-900 hover:text-[#FC4C02]" %></td>
              <td class="px-4 py-3 text-sm text-gray-600"><%= season.starts_at&.strftime("%b %-d") %> – <%= season.ends_at&.strftime("%b %-d, %Y") %></td>
              <td class="px-4 py-3"><span class="text-xs px-2 py-1 rounded-full <%= season_status_badge_class(season.status) %>"><%= t("seasons.statuses.#{season.status}", default: season.status.capitalize) %></span></td>
              <td class="px-4 py-3 text-right text-sm whitespace-nowrap">
                <%= link_to t("admin.seasons.edit"), edit_admin_season_path(season), class: "text-gray-600 hover:text-[#FC4C02] mr-3" %>
                <%= button_to t("admin.seasons.delete"), admin_season_path(season), method: :delete, form: { class: "inline", data: { turbo_confirm: t("admin.seasons.confirm_delete") } }, class: "text-red-600 hover:text-red-800 cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500 py-8"><%= t("admin.seasons.empty") %></p>
  <% end %>
</div>
