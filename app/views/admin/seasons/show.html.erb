<div class="pt-8">
  <div class="flex items-start justify-between mb-6">
    <div>
      <%= link_to admin_seasons_path, class: "text-sm text-gray-500 hover:text-[#FC4C02] flex items-center gap-1 mb-2" do %>
        <i class="fa-solid fa-arrow-left text-xs"></i> <%= t("admin.seasons.title") %>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-900"><%= @season.name %></h1>
      <p class="text-sm text-gray-500 mt-1">
        <span class="px-2 py-0.5 rounded-full text-xs <%= season_status_badge_class(@season.status) %>"><%= t("seasons.statuses.#{@season.status}", default: @season.status.capitalize) %></span>
        · ×<%= @season.xp_multiplier %> XP
        · <%= t("admin.seasons.fields.max_level") %>: <%= @season.max_level %> (<%= number_with_delimiter(@season.effective_top_level_xp) %> XP)
        · <%= @season.starts_at&.strftime("%b %-d") %> – <%= @season.ends_at&.strftime("%b %-d, %Y") %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to t("admin.seasons.edit"), edit_admin_season_path(@season), class: "bg-[#FC4C02] text-white px-4 py-2 rounded-lg hover:bg-[#e04402] transition font-medium text-sm" %>
      <%= link_to t("admin.seasons.view_public"), season_path(@season), class: "border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition font-medium text-sm" %>
    </div>
  </div>

  <%# Telling players a season has opened. Sent automatically when a season goes
      active; this is the manual path for one that was already running. %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 mb-6">
    <h2 class="text-sm font-semibold text-gray-900 mb-1"><%= t("admin.seasons.announce.title") %></h2>
    <p class="text-xs text-gray-500 mb-3">
      <% if @season.announced_at %>
        <%= t("admin.seasons.announce.sent_on", date: l(@season.announced_at, format: :long)) %>
      <% else %>
        <%= t("admin.seasons.announce.not_sent") %>
      <% end %>
      · <%= t("admin.seasons.announce.reach", subscribed: PushSubscription.distinct.count(:user_id), total: User.count) %>
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <%= button_to t(@season.announced_at ? "admin.seasons.announce.resend" : "admin.seasons.announce.send"),
                    announce_admin_season_path(@season, force: @season.announced_at ? true : nil),
                    method: :post,
                    disabled: !@season.active?,
                    form: { data: { turbo_confirm: t("admin.seasons.announce.confirm") } },
                    class: "bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
      <% unless @season.active? %>
        <span class="text-xs text-gray-400"><%= t("admin.seasons.announce.only_active") %></span>
      <% end %>
    </div>
  </div>

  <%# Reuse this season as the basis for the next one. %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 mb-6">
    <h2 class="text-sm font-semibold text-gray-900 mb-1"><%= t("admin.seasons.export.title") %></h2>
    <p class="text-xs text-gray-500 mb-3"><%= t("admin.seasons.export.hint") %></p>
    <%= form_with url: export_admin_season_path(@season), method: :get, class: "flex flex-wrap items-end gap-3" do %>
      <div class="min-w-45">
        <label class="block text-xs text-gray-500 mb-1"><%= t("admin.seasons.export.new_key") %></label>
        <%= text_field_tag :new_key, "", placeholder: "#{@season.key}_next", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div class="min-w-45">
        <label class="block text-xs text-gray-500 mb-1"><%= t("admin.seasons.export.new_name") %></label>
        <%= text_field_tag :new_name, "", placeholder: @season.name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div class="min-w-44">
        <%# Every date moves by the same offset, so a week-3 challenge stays in week 3. %>
        <label class="block text-xs text-gray-500 mb-1"><%= t("admin.seasons.export.shift_to") %></label>
        <%= date_field_tag :shift_to, "", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <%= submit_tag t("admin.seasons.export.download"), name: nil,
                     class: "bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm cursor-pointer" %>
    <% end %>
  </div>

  <%# Lowering the level count strands anything pinned above the new ceiling.
      Say so here rather than letting that content go quietly dead. %>
  <% warnings = @season.level_config_warnings %>
  <% if warnings.any? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 mb-6">
      <% warnings.each do |warning| %>
        <p class="text-sm text-amber-800">
          <i class="fa-solid fa-triangle-exclamation mr-1"></i>
          <%= t("admin.seasons.warnings.unreachable_#{warning[:kind]}", count: warning[:records].size, max: @season.max_level) %>
        </p>
        <p class="text-xs text-amber-700 mt-1 ml-5">
          <%= warning[:records].map { |r| r.respond_to?(:reward_key) ? "#{r.reward_key} (L#{r.level})" : "#{r.challenge.display_title} (L#{r.unlock_level})" }.join(" · ") %>
        </p>
      <% end %>
    </div>
  <% end %>

  <div class="grid lg:grid-cols-2 gap-6">
    <%# Challenges %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t("admin.seasons.challenges.title") %></h2>
      <div class="space-y-2 mb-5">
        <% @season_challenges.each do |sc| %>
          <div class="flex items-center justify-between border border-gray-100 rounded-lg px-3 py-2 text-sm">
            <div>
              <span class="font-medium text-gray-900"><%= sc.challenge.display_title %></span>
              <span class="text-gray-400">
                · <%= t("seasons.categories.#{sc.category}", default: sc.category) %>
                · +<%= sc.xp_reward %> XP<%= " · #{t('seasons.show.required')}" if sc.required %>
                <%= " · #{t('seasons.show.unlocks_at_level', level: sc.unlock_level)}" if sc.unlock_level.positive? %>
              </span>
              <% if sc.hidden? %>
                <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded-full bg-purple-100 text-purple-700"><%= t("seasons.show.secret") %></span>
              <% end %>
            </div>
            <%= button_to t("admin.seasons.challenges.remove"), admin_season_season_challenge_path(@season, sc), method: :delete, form: { class: "inline" }, class: "text-red-600 hover:text-red-800 text-xs cursor-pointer" %>
          </div>
        <% end %>
        <% if @season_challenges.empty? %>
          <p class="text-gray-400 text-sm"><%= t("admin.seasons.challenges.empty") %></p>
        <% end %>
      </div>

      <% if @available_challenges.any? %>
        <%= form_with url: admin_season_season_challenges_path(@season), scope: :season_challenge, class: "border-t border-gray-100 pt-4 space-y-3" do |f| %>
          <%= f.select :challenge_id, @available_challenges.map { |c| [c.display_title, c.id] }, { prompt: t("admin.seasons.challenges.select") }, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <%= f.label :xp_reward, t("admin.seasons.challenges.xp"), class: "block text-xs text-gray-500 mb-1" %>
              <%= f.number_field :xp_reward, value: 100, min: 0, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
            </div>
            <div>
              <%= f.label :position, t("admin.seasons.challenges.position"), class: "block text-xs text-gray-500 mb-1" %>
              <%= f.number_field :position, value: @season_challenges.size, min: 0, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <%= f.label :category, t("admin.seasons.challenges.category"), class: "block text-xs text-gray-500 mb-1" %>
              <%= f.select :category, SeasonChallenge::CATEGORIES.map { |c| [t("seasons.categories.#{c}", default: c), c] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
            </div>
            <div>
              <%= f.label :unlock_level, t("admin.seasons.challenges.unlock_level"), class: "block text-xs text-gray-500 mb-1" %>
              <%= f.number_field :unlock_level, value: 0, min: 0, max: @season.max_level, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
            </div>
            <div>
              <%= f.label :coin_reward, t("admin.seasons.challenges.coins"), class: "block text-xs text-gray-500 mb-1" %>
              <%= f.number_field :coin_reward, value: 0, min: 0, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
            </div>
            <div>
              <%= f.label :fragment_reward, t("admin.seasons.challenges.fragments"), class: "block text-xs text-gray-500 mb-1" %>
              <%= f.number_field :fragment_reward, value: 0, min: 0, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
            </div>
          </div>
          <div class="flex flex-wrap gap-4">
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <%= f.check_box :required, class: "rounded text-[#FC4C02]" %> <%= t("admin.seasons.challenges.required") %>
            </label>
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <%= f.check_box :hidden, class: "rounded text-[#FC4C02]" %> <%= t("admin.seasons.challenges.hidden") %>
            </label>
          </div>
          <%= f.submit t("admin.seasons.challenges.add"), class: "bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm cursor-pointer" %>
        <% end %>
      <% end %>
    </div>

    <%# Rewards %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t("admin.seasons.rewards.title") %></h2>
      <div class="space-y-2 mb-5">
        <% @season.season_rewards.each do |reward| %>
          <div class="flex items-center justify-between border border-gray-100 rounded-lg px-3 py-2 text-sm">
            <div>
              <span class="font-medium text-gray-900">
                <%= t("seasons.unlock_kinds.#{reward.unlock_kind}", value: reward.unlock_value, default: reward.unlock_kind) %>
              </span>
              <span class="text-gray-400">· <%= reward.reward_type %> · <%= reward.name.presence || reward.reward_key %></span>
              <% if reward.premium? %>
                <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-700"><%= t("seasons.tracks.premium") %></span>
              <% end %>
            </div>
            <%= button_to t("admin.seasons.rewards.remove"), admin_season_season_reward_path(@season, reward), method: :delete, form: { class: "inline" }, class: "text-red-600 hover:text-red-800 text-xs cursor-pointer" %>
          </div>
        <% end %>
        <% if @season.season_rewards.empty? %>
          <p class="text-gray-400 text-sm"><%= t("admin.seasons.rewards.empty") %></p>
        <% end %>
      </div>

      <%= form_with url: admin_season_season_rewards_path(@season), scope: :season_reward, class: "border-t border-gray-100 pt-4 space-y-3" do |f| %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label :level, t("admin.seasons.rewards.level"), class: "block text-xs text-gray-500 mb-1" %>
            <%= f.number_field :level, value: 2, min: 1, max: @season.max_level, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :reward_type, t("admin.seasons.rewards.type"), class: "block text-xs text-gray-500 mb-1" %>
            <%= f.select :reward_type, SeasonReward::REWARD_TYPES.map { |rt| [t("seasons.reward_types.#{rt}", default: rt), rt] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :track, t("admin.seasons.rewards.track"), class: "block text-xs text-gray-500 mb-1" %>
            <%= f.select :track, SeasonReward::TRACKS.map { |track| [t("seasons.tracks.#{track}", default: track), track] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :coins, t("admin.seasons.rewards.coins"), class: "block text-xs text-gray-500 mb-1" %>
            <%= f.number_field :coins, value: 0, min: 0, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          </div>
        </div>
        <div>
          <%= f.label :reward_key, t("admin.seasons.rewards.key"), class: "block text-xs text-gray-500 mb-1" %>
          <%= f.text_field :reward_key, placeholder: "trail_hunter", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          <p class="text-xs text-gray-400 mt-1"><%= t("admin.seasons.rewards.key_hint") %></p>
        </div>
        <div>
          <%= f.label :name, t("admin.seasons.rewards.name"), class: "block text-xs text-gray-500 mb-1" %>
          <%= f.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        </div>
        <%= f.submit t("admin.seasons.rewards.add"), class: "bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <%# Club / action objectives %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1"><%= t("admin.seasons.objectives.title") %></h2>
    <p class="text-sm text-gray-500 mb-4"><%= t("admin.seasons.objectives.hint") %></p>

    <div class="space-y-2 mb-5">
      <% @season.season_objectives.each do |objective| %>
        <div class="flex items-center justify-between border border-gray-100 rounded-lg px-3 py-2 text-sm">
          <div>
            <span class="font-medium text-gray-900"><%= objective.name.presence || t("seasons.objectives.kinds.#{objective.kind}", default: objective.kind) %></span>
            <span class="text-gray-400">· +<%= objective.xp_reward %> XP<%= " · ×#{objective.target}" if objective.target > 1 %><%= " · #{t('seasons.show.required')}" if objective.required %></span>
          </div>
          <%= button_to t("admin.seasons.objectives.remove"), admin_season_season_objective_path(@season, objective), method: :delete, form: { class: "inline" }, class: "text-red-600 hover:text-red-800 text-xs cursor-pointer" %>
        </div>
      <% end %>
      <% if @season.season_objectives.empty? %>
        <p class="text-gray-400 text-sm"><%= t("admin.seasons.objectives.empty") %></p>
      <% end %>
    </div>

    <%= form_with url: admin_season_season_objectives_path(@season), scope: :season_objective, class: "border-t border-gray-100 pt-4 grid grid-cols-1 sm:grid-cols-4 gap-3 items-end" do |f| %>
      <div>
        <%= f.label :kind, t("admin.seasons.objectives.kind"), class: "block text-xs text-gray-500 mb-1" %>
        <%= f.select :kind, SeasonObjective::KINDS.map { |k| [t("seasons.objectives.kinds.#{k}", default: k), k] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :xp_reward, t("admin.seasons.objectives.xp"), class: "block text-xs text-gray-500 mb-1" %>
        <%= f.number_field :xp_reward, value: 200, min: 0, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :target, t("admin.seasons.objectives.target"), class: "block text-xs text-gray-500 mb-1" %>
        <%= f.number_field :target, value: 1, min: 1, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.submit t("admin.seasons.objectives.add"), class: "w-full bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-medium text-sm cursor-pointer" %>
      </div>
    <% end %>
    <p class="text-xs text-gray-400 mt-2"><%= t("admin.seasons.objectives.target_hint") %></p>
  </div>

  <%# Participants %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t("admin.seasons.participants", count: @season.season_participations.size) %></h2>
    <div class="space-y-1">
      <% @participations.each_with_index do |p, i| %>
        <div class="flex items-center justify-between text-sm py-1">
          <span class="text-gray-700"><%= i + 1 %>. <%= p.user.first_name %> <%= p.user.last_name %></span>
          <span class="font-medium text-gray-900"><%= p.xp %> XP · L<%= p.level %></span>
        </div>
      <% end %>
      <% if @participations.empty? %>
        <p class="text-gray-400 text-sm"><%= t("admin.seasons.no_participants") %></p>
      <% end %>
    </div>
  </div>
</div>
