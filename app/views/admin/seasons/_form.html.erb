<%= form_with model: [:admin, season], html: { multipart: true, class: "space-y-6" } do |f| %>
  <% if season.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4">
      <ul class="list-disc list-inside text-sm">
        <% season.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-5">
    <div>
      <%= f.label :name, t("admin.seasons.fields.name"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    </div>

    <div>
      <%= f.label :key, t("admin.seasons.fields.key"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :key, placeholder: "summer_miles", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    </div>

    <div>
      <%= f.label :description, t("admin.seasons.fields.description"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :theme, t("admin.seasons.fields.theme"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :theme, Season::THEMES.map { |th| [t("seasons.themes.#{th}", default: th.capitalize), th] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>
      <div>
        <%= f.label :status, t("admin.seasons.fields.status"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status, Season::STATUSES.map { |s| [t("seasons.statuses.#{s}", default: s.capitalize), s] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>
      <div>
        <%= f.label :starts_at, t("admin.seasons.fields.starts_at"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.datetime_local_field :starts_at, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>
      <div>
        <%= f.label :ends_at, t("admin.seasons.fields.ends_at"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.datetime_local_field :ends_at, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>
      <div>
        <%= f.label :xp_multiplier, t("admin.seasons.fields.xp_multiplier"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :xp_multiplier, step: "0.1", min: 0.1, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>
    </div>

    <div>
      <%= f.label :image, t("admin.seasons.fields.image"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if season.image.attached? %>
        <%= image_tag season.image.variant(resize_to_limit: [200, 200]), class: "rounded-lg border border-gray-200 mb-3" %>
      <% end %>
      <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp", class: "block w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[#FC4C02] file:text-white file:cursor-pointer hover:file:bg-[#e04402]" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit t("admin.seasons.form.save"), class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
    <%= link_to t("admin.seasons.form.cancel"), admin_seasons_path, class: "border border-gray-300 px-6 py-2.5 rounded-lg hover:bg-gray-50 transition font-medium" %>
  </div>
<% end %>
