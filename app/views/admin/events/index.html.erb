<div class="pt-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.events.title") %></h1>
    <%= link_to new_admin_event_path, class: "bg-[#FC4C02] text-white px-4 py-2 rounded-lg hover:bg-[#e04402] transition font-medium text-sm flex items-center gap-2" do %>
      <i class="fa-solid fa-plus"></i> <%= t("admin.events.new") %>
    <% end %>
  </div>

  <% if @events.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.events.fields.title") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.events.fields.sport") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.events.fields.event_date") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.events.fields.attendees") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.events.fields.status") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.events.fields.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @events.each do |event| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3">
                <%= link_to event.title, admin_event_path(event), class: "font-medium text-gray-900 hover:text-[#FC4C02]" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600">
                <%= t("enums.sports.#{event.sport}", default: event.sport&.capitalize.to_s) %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600">
                <%= event.event_date&.strftime("%Y-%m-%d %H:%M") || "—" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600">
                <i class="fa-solid fa-user-group text-gray-400 mr-1"></i><%= event.event_participations_count %>
              </td>
              <td class="px-4 py-3">
                <span class="text-xs px-2 py-1 rounded-full <%= event.upcoming? ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
                  <%= t("admin.events.statuses.#{event.status}", default: event.status.to_s.capitalize) %>
                </span>
              </td>
              <td class="px-4 py-3 text-right text-sm whitespace-nowrap">
                <%= link_to t("admin.events.edit"), edit_admin_event_path(event), class: "text-gray-600 hover:text-[#FC4C02] mr-3" %>
                <%= button_to t("admin.events.delete"), admin_event_path(event), method: :delete, form: { class: "inline", data: { turbo_confirm: t("admin.events.confirm_delete") } }, class: "text-red-600 hover:text-red-800 cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500 py-8"><%= t("admin.events.empty") %></p>
  <% end %>
</div>
