<%= form_with model: [:admin, event], html: { multipart: true, class: "space-y-6" } do |f| %>
  <% if event.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4">
      <p class="font-medium mb-1"><%= t("admin.events.form.errors", count: event.errors.count) %></p>
      <ul class="list-disc list-inside text-sm">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-5">
    <div>
      <%= f.label :title, t("admin.events.fields.title"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    </div>

    <div>
      <%= f.label :description, t("admin.events.fields.description"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <%= f.label :sport, t("admin.events.fields.sport"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :sport,
              Event::SPORTS.map { |s| [t("enums.sports.#{s}", default: s.capitalize), s] },
              { include_blank: t("admin.events.form.any") },
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>

      <div>
        <%= f.label :status, t("admin.events.fields.status"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status,
              Event::STATUSES.map { |s| [t("admin.events.statuses.#{s}", default: s.capitalize), s] },
              {},
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>

      <div>
        <%= f.label :event_date, t("admin.events.fields.event_date"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.datetime_local_field :event_date, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>

      <div>
        <%= f.label :location, t("admin.events.fields.location"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :location, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      </div>
    </div>

    <%# Distances offered — quick-pick standard distances plus custom values %>
    <div>
      <span class="block text-sm font-medium text-gray-700 mb-2"><%= t("admin.events.fields.distances") %></span>
      <%= hidden_field_tag "event[distances][]", "" %>
      <div class="flex flex-wrap gap-2 mb-3">
        <% Event::STANDARD_DISTANCES.each do |d| %>
          <label class="inline-flex items-center gap-2 px-3 py-2 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50">
            <%= check_box_tag "event[distances][]", d, event.distances.map(&:to_f).include?(d.to_f), class: "rounded text-[#FC4C02] focus:ring-[#FC4C02]" %>
            <span class="text-sm font-medium text-gray-800"><%= d %> km</span>
          </label>
        <% end %>
      </div>
      <%= label_tag "event_custom_distances", t("admin.events.fields.custom_distances"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% custom = (event.distances.map(&:to_f) - Event::STANDARD_DISTANCES.map(&:to_f)) %>
      <%= text_field_tag "event[custom_distances]", custom.map { |d| (d % 1).zero? ? d.to_i : d }.join(", "), placeholder: "3, 8, 15", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
      <p class="text-xs text-gray-400 mt-1"><%= t("admin.events.form.custom_distances_hint") %></p>
    </div>

    <div>
      <%= f.label :image, t("admin.events.fields.image"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if event.image.attached? %>
        <div class="mb-3">
          <%= image_tag event.image.variant(resize_to_limit: [200, 200]), class: "rounded-lg border border-gray-200" %>
        </div>
      <% end %>
      <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp", class: "block w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[#FC4C02] file:text-white file:cursor-pointer hover:file:bg-[#e04402]" %>
      <p class="text-xs text-gray-400 mt-1"><%= t("admin.events.form.image_hint") %></p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit t("admin.events.form.save"), class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
    <%= link_to t("admin.events.form.cancel"), admin_events_path, class: "border border-gray-300 px-6 py-2.5 rounded-lg hover:bg-gray-50 transition font-medium" %>
  </div>
<% end %>
