<div class="pt-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.challenges.title") %></h1>
    <%= link_to new_admin_challenge_path, class: "bg-[#FC4C02] text-white px-4 py-2 rounded-lg hover:bg-[#e04402] transition font-medium text-sm flex items-center gap-2" do %>
      <i class="fa-solid fa-plus"></i> <%= t("admin.challenges.new") %>
    <% end %>
  </div>

  <% if @challenges.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.challenges.fields.title") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.challenges.fields.sport") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.challenges.fields.type") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.challenges.fields.status") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("admin.challenges.fields.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @challenges.each do |challenge| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3">
                <%= link_to challenge.display_title, admin_challenge_path(challenge), class: "font-medium text-gray-900 hover:text-[#FC4C02]" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600">
                <%= t("enums.sports.#{challenge.sport}", default: challenge.sport&.capitalize.to_s) %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600">
                <%= t("enums.challenge_types.#{challenge.challenge_type}", default: challenge.challenge_type&.capitalize.to_s) %>
              </td>
              <td class="px-4 py-3">
                <span class="text-xs px-2 py-1 rounded-full <%= challenge.status == 'active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' %>">
                  <%= t("admin.challenges.statuses.#{challenge.status}", default: challenge.status.to_s.capitalize) %>
                </span>
              </td>
              <td class="px-4 py-3 text-right text-sm whitespace-nowrap">
                <%= link_to t("admin.challenges.edit"), edit_admin_challenge_path(challenge), class: "text-gray-600 hover:text-[#FC4C02] mr-3" %>
                <%= button_to t("admin.challenges.delete"), admin_challenge_path(challenge), method: :delete, form: { class: "inline", data: { turbo_confirm: t("admin.challenges.confirm_delete") } }, class: "text-red-600 hover:text-red-800 cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500 py-8"><%= t("admin.challenges.empty") %></p>
  <% end %>
</div>
