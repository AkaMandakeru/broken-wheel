<div class="pt-8 max-w-3xl mx-auto">
  <%= link_to admin_support_tickets_path, class: "text-sm text-gray-500 hover:text-[#FC4C02] flex items-center gap-1 mb-2" do %>
    <i class="fa-solid fa-arrow-left text-xs"></i> <%= t("admin.support.title") %>
  <% end %>

  <div class="flex items-start justify-between gap-3 mb-1">
    <h1 class="text-2xl font-bold text-gray-900"><%= @ticket.subject %></h1>
    <span class="text-xs px-2 py-1 rounded-full whitespace-nowrap <%= status_badge_class(@ticket.status) %>">
      <%= t("support.statuses.#{@ticket.status}") %>
    </span>
  </div>
  <p class="text-sm text-gray-500 mb-1">
    <%= @ticket.user.first_name %> <%= @ticket.user.last_name %> ·
    <%= t("support.categories.#{@ticket.category}") %> ·
    <%= t("support.sources.#{@ticket.source}", default: @ticket.source.to_s.capitalize) %>
  </p>
  <div class="mb-6">
    <%= form_with url: admin_support_ticket_path(@ticket), method: :patch, class: "inline" do %>
      <% if @ticket.closed? %>
        <%= hidden_field_tag "support_ticket[status]", "open" %>
        <%= submit_tag t("admin.support.reopen"), class: "text-sm text-gray-600 hover:text-[#FC4C02] cursor-pointer bg-transparent border-0 p-0" %>
      <% else %>
        <%= hidden_field_tag "support_ticket[status]", "closed" %>
        <%= submit_tag t("admin.support.close"), class: "text-sm text-gray-600 hover:text-red-600 cursor-pointer bg-transparent border-0 p-0" %>
      <% end %>
    <% end %>
  </div>

  <div class="space-y-3 mb-6">
    <% @messages.each do |message| %>
      <%= render "support_tickets/message", message: message %>
    <% end %>
  </div>

  <%= form_with url: admin_support_ticket_messages_path(@ticket), scope: :support_message, class: "bg-white rounded-lg shadow-sm border border-gray-200 p-4 space-y-3" do |f| %>
    <%= f.label :body, t("admin.support.reply_label"), class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :body, rows: 3, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-[#FC4C02] focus:ring-[#FC4C02] focus:outline-none" %>
    <%= f.submit t("admin.support.reply_submit"), class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
  <% end %>
</div>
