<%= form_with model: [ :admin, cosmetic ], class: "space-y-6" do |f| %>
  <% if cosmetic.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <ul class="list-disc list-inside text-sm text-red-700">
        <% cosmetic.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, t("admin.cosmetics.fields.name"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :key, t("admin.cosmetics.fields.key"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :key, placeholder: "legacy_of_champions", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono" %>
        <p class="text-xs text-gray-400 mt-1"><%= t("admin.cosmetics.form.key_hint") %></p>
      </div>
      <div>
        <%= f.label :kind, t("admin.cosmetics.fields.kind"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :kind,
              Cosmetic::PICTURE_KINDS.map { |kind| [ t("cosmetics.kinds.#{kind}"), kind ] },
              {},
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :rarity, t("admin.cosmetics.fields.rarity"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :rarity,
              Cosmetic::RARITIES.map { |rarity| [ t("cosmetics.rarities.#{rarity}"), rarity ] },
              {},
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :position, t("admin.cosmetics.fields.position"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :position, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end gap-4 pb-2">
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= f.check_box :renderable, class: "rounded border-gray-300" %>
          <%= t("admin.cosmetics.fields.renderable") %>
        </label>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= f.check_box :animated, class: "rounded border-gray-300" %>
          <%= t("admin.cosmetics.fields.animated") %>
        </label>
      </div>
    </div>

    <div>
      <%= f.label :image, t("admin.cosmetics.fields.image"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if cosmetic.image.attached? %>
        <div class="mb-3">
          <%= image_tag cosmetic.image.variant(resize_to_limit: [ 240, 240 ]), class: "rounded-lg border border-gray-200 bg-gray-50" %>
        </div>
      <% end %>
      <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp",
            class: "block w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[#FC4C02] file:text-white file:cursor-pointer hover:file:bg-[#e04402]" %>
      <p class="text-xs text-gray-400 mt-1"><%= t("admin.cosmetics.form.image_hint") %></p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit t("admin.cosmetics.form.save"), class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium cursor-pointer" %>
    <%= link_to t("admin.cosmetics.form.cancel"), admin_cosmetics_path, class: "border border-gray-300 px-6 py-2.5 rounded-lg hover:bg-gray-50 transition font-medium" %>
  </div>
<% end %>
