<div data-controller="sidebar">
  <nav class="fixed top-0 left-0 right-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex h-16 items-center justify-between">
        <%# Left: mobile toggle + brand %>
        <div class="flex items-center gap-3">
          <button type="button"
                  data-action="click->sidebar#toggle"
                  class="md:hidden p-2 -ml-2 text-foreground hover:text-primary focus:outline-none cursor-pointer touch-manipulation"
                  aria-label="<%= t('shared.nav.open_menu') %>">
            <i class="fa-solid fa-bars text-xl"></i>
          </button>
          <%= link_to (user_signed_in? ? challenges_path : root_path), class: "flex items-center gap-3" do %>
            <%= image_tag "logo.png", alt: "Broken Wheels", class: "h-10 w-10 md:h-12 md:w-12 object-contain" %>
            <span class="text-xl font-bold text-foreground">Broken Wheels</span>
          <% end %>
        </div>

        <%# Center: desktop nav links %>
        <nav class="hidden md:flex items-center gap-8">
          <% if user_signed_in? %>
            <%= link_to challenges_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
              <i class="fa-solid fa-trophy"></i> <%= t('shared.nav.challenges') %>
            <% end %>
            <%= link_to events_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
              <i class="fa-solid fa-flag-checkered"></i> <%= t('shared.nav.events') %>
            <% end %>
            <%= link_to workouts_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
              <i class="fa-solid fa-dumbbell"></i> <%= t('shared.nav.workouts') %>
            <% end %>
            <%= link_to achievements_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
              <i class="fa-solid fa-medal"></i> <%= t('shared.nav.achievements') %>
            <% end %>
            <%= link_to clubs_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
              <i class="fa-solid fa-users"></i> <%= t('shared.nav.clubs') %>
            <% end %>
            <%= link_to profile_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
              <i class="fa-solid fa-user"></i> <%= t('shared.nav.profile') %>
            <% end %>
            <% if current_user.admin? %>
              <%= link_to admin_root_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
                <i class="fa-solid fa-shield-halved"></i> <%= t('shared.nav.admin') %>
              <% end %>
            <% end %>
            <% if current_user.connected_to_strava? %>
              <%= link_to integrations_path, class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2" do %>
                <i class="fa-solid fa-plug"></i> <%= t('shared.nav.apps') %>
              <% end %>
            <% else %>
              <%= link_to integrations_path, class: "text-sm font-medium bg-[#FC4C02] text-white px-3 py-1.5 rounded-lg hover:bg-[#e04402] transition flex items-center gap-2" do %>
                <i class="fa-solid fa-plug"></i> <%= t('shared.nav.connect_app') %>
              <% end %>
            <% end %>
          <% else %>
            <%= link_to t('shared.nav.features'),  root_path(anchor: 'features'),   class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors" %>
            <%= link_to t('shared.nav.challenges'), root_path(anchor: 'challenges'), class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors" %>
            <%= link_to t('shared.nav.community'), root_path(anchor: 'community'),  class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors" %>
            <%= link_to t('shared.nav.contact'),   root_path(anchor: 'contact'),    class: "text-sm font-medium text-muted-foreground hover:text-primary transition-colors" %>
          <% end %>
        </nav>

        <%# Right: language globe + auth CTAs (desktop) %>
        <div class="hidden md:flex items-center gap-2">
          <%# Language globe dropdown %>
          <div class="relative" id="language-dropdown">
            <button type="button"
                    onclick="toggleDropdown()"
                    class="flex items-center gap-1 p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-muted transition-colors"
                    aria-label="<%= t('shared.nav.language') %>">
              <i class="fa-solid fa-globe text-lg"></i>
              <span class="text-xs font-medium uppercase"><%= I18n.locale %></span>
            </button>
            <div id="dropdown-menu" class="hidden absolute top-full right-0 mt-2 w-48 bg-background border border-border rounded-lg shadow-lg overflow-hidden z-50">
              <%= link_to switch_locale_path(locale: :en), class: "flex items-center gap-3 px-4 py-3 text-sm transition #{I18n.locale == :en ? 'bg-muted text-primary' : 'text-foreground hover:bg-muted'}" do %>
                <span class="flex-1"><%= t('shared.nav.language_english') %></span>
                <% if I18n.locale == :en %>
                  <i class="fa-solid fa-check text-primary text-xs"></i>
                <% end %>
              <% end %>
              <%= link_to switch_locale_path(locale: :pt), class: "flex items-center gap-3 px-4 py-3 text-sm transition #{I18n.locale == :pt ? 'bg-muted text-primary' : 'text-foreground hover:bg-muted'}" do %>
                <span class="flex-1"><%= t('shared.nav.language_portuguese') %></span>
                <% if I18n.locale == :pt %>
                  <i class="fa-solid fa-check text-primary text-xs"></i>
                <% end %>
              <% end %>
            </div>
          </div>

          <% if user_signed_in? %>
            <%= button_to destroy_user_session_path, method: :delete, form_class: "inline", class: "text-sm font-medium text-foreground hover:text-primary transition-colors flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-muted" do %>
              <i class="fa-solid fa-right-from-bracket"></i> <%= t('shared.nav.log_out') %>
            <% end %>
          <% else %>
            <%= link_to t('shared.nav.log_in'), new_user_session_path,
                  class: "text-sm font-medium text-foreground hover:text-primary transition-colors px-4 py-2 rounded-lg hover:bg-muted" %>
            <%= link_to t('shared.nav.get_started'), new_user_registration_path,
                  class: "text-sm font-medium bg-primary text-primary-foreground hover:bg-primary-hover transition-colors px-4 py-2 rounded-lg" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <%# Sidebar overlay (mobile) %>
  <div data-sidebar-target="overlay"
       class="hidden fixed inset-0 z-[60] bg-black/50 md:hidden transition-opacity"
       data-action="click->sidebar#close"
       aria-hidden="true"></div>

  <%# Sidebar panel (mobile) %>
  <aside data-sidebar-target="panel"
         class="fixed top-0 left-0 z-[70] h-full w-72 -translate-x-full transition-transform duration-300 ease-in-out md:hidden bg-background border-r border-border shadow-xl">
    <div class="flex flex-col h-full">
      <%# Sidebar header %>
      <div class="flex items-center justify-between h-16 px-4 border-b border-border">
        <%= link_to (user_signed_in? ? challenges_path : root_path), class: "flex items-center gap-2", data: { action: "click->sidebar#close" } do %>
          <%= image_tag "logo.png", alt: "Broken Wheels", class: "h-8 w-8 object-contain" %>
          <span class="text-base font-bold text-foreground">Broken Wheels</span>
        <% end %>
        <button type="button"
                data-action="click->sidebar#close"
                class="p-2 text-muted-foreground hover:text-primary"
                aria-label="<%= t('shared.nav.close_menu') %>">
          <i class="fa-solid fa-xmark text-xl"></i>
        </button>
      </div>

      <%# Sidebar content %>
      <div class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
        <% if user_signed_in? %>
          <%= link_to challenges_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-trophy w-5 text-muted-foreground"></i> <%= t('shared.nav.challenges') %>
          <% end %>
          <%= link_to events_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-flag-checkered w-5 text-muted-foreground"></i> <%= t('shared.nav.events') %>
          <% end %>
          <%= link_to workouts_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-dumbbell w-5 text-muted-foreground"></i> <%= t('shared.nav.workouts') %>
          <% end %>
          <%= link_to achievements_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-medal w-5 text-muted-foreground"></i> <%= t('shared.nav.achievements') %>
          <% end %>
          <%= link_to clubs_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-users w-5 text-muted-foreground"></i> <%= t('shared.nav.clubs') %>
          <% end %>
          <%= link_to profile_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-user w-5 text-muted-foreground"></i> <%= t('shared.nav.profile') %>
          <% end %>
          <% if current_user.admin? %>
            <%= link_to admin_root_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
              <i class="fa-solid fa-shield-halved w-5 text-muted-foreground"></i> <%= t('shared.nav.admin') %>
            <% end %>
          <% end %>
          <% if current_user.connected_to_strava? %>
            <%= link_to integrations_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
              <i class="fa-solid fa-plug w-5 text-muted-foreground"></i> <%= t('shared.nav.apps') %>
            <% end %>
          <% else %>
            <%= link_to integrations_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg bg-[#FC4C02] text-white hover:bg-[#e04402] transition font-medium", data: { action: "click->sidebar#close" } do %>
              <i class="fa-solid fa-plug w-5"></i> <%= t('shared.nav.connect_app') %>
            <% end %>
          <% end %>
        <% else %>
          <%= link_to root_path(anchor: 'features'), class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-star w-5 text-muted-foreground"></i> <%= t('shared.nav.features') %>
          <% end %>
          <%= link_to root_path(anchor: 'challenges'), class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-trophy w-5 text-muted-foreground"></i> <%= t('shared.nav.challenges') %>
          <% end %>
          <%= link_to root_path(anchor: 'community'), class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-users w-5 text-muted-foreground"></i> <%= t('shared.nav.community') %>
          <% end %>
          <%= link_to root_path(anchor: 'contact'), class: "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition", data: { action: "click->sidebar#close" } do %>
            <i class="fa-solid fa-envelope w-5 text-muted-foreground"></i> <%= t('shared.nav.contact') %>
          <% end %>
        <% end %>

        <hr class="my-3 border-border">

        <%# Language picker (flat list on mobile) %>
        <div class="px-4 pt-1 pb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          <%= t('shared.nav.language') %>
        </div>
        <%= link_to switch_locale_path(locale: :en), class: "flex items-center gap-3 px-4 py-3 rounded-lg transition #{I18n.locale == :en ? 'bg-muted text-primary' : 'text-foreground hover:bg-muted hover:text-primary'}", data: { action: "click->sidebar#close" } do %>
          <i class="fa-solid fa-globe w-5 text-muted-foreground"></i>
          <span class="flex-1"><%= t('shared.nav.language_english') %></span>
          <% if I18n.locale == :en %>
            <i class="fa-solid fa-check text-primary text-xs"></i>
          <% end %>
        <% end %>
        <%= link_to switch_locale_path(locale: :pt), class: "flex items-center gap-3 px-4 py-3 rounded-lg transition #{I18n.locale == :pt ? 'bg-muted text-primary' : 'text-foreground hover:bg-muted hover:text-primary'}", data: { action: "click->sidebar#close" } do %>
          <i class="fa-solid fa-globe w-5 text-muted-foreground"></i>
          <span class="flex-1"><%= t('shared.nav.language_portuguese') %></span>
          <% if I18n.locale == :pt %>
            <i class="fa-solid fa-check text-primary text-xs"></i>
          <% end %>
        <% end %>
      </div>

      <%# Sidebar footer: auth CTAs %>
      <div class="border-t border-border p-4 space-y-2">
        <% if user_signed_in? %>
          <%= button_to destroy_user_session_path, method: :delete, form_class: "block", class: "flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg text-foreground hover:bg-muted hover:text-primary transition font-medium" do %>
            <i class="fa-solid fa-right-from-bracket"></i> <%= t('shared.nav.log_out') %>
          <% end %>
        <% else %>
          <%= link_to t('shared.nav.log_in'), new_user_session_path,
                class: "flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg text-foreground border border-border hover:bg-muted transition font-medium",
                data: { action: "click->sidebar#close" } %>
          <%= link_to t('shared.nav.get_started'), new_user_registration_path,
                class: "flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg bg-primary text-primary-foreground hover:bg-primary-hover transition font-medium",
                data: { action: "click->sidebar#close" } %>
        <% end %>
      </div>
    </div>
  </aside>
</div>

<script>
  function toggleDropdown() {
    const menu = document.getElementById('dropdown-menu');
    if (!menu) return;
    menu.classList.toggle('hidden');
  }

  document.addEventListener('click', function (event) {
    const desktopDropdown = document.getElementById('language-dropdown');
    if (desktopDropdown && !desktopDropdown.contains(event.target)) {
      const menu = document.getElementById('dropdown-menu');
      if (menu) menu.classList.add('hidden');
    }
  });
</script>
