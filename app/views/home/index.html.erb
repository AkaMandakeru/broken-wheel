<% content_for :title, t("home.meta.title") %>

<% feature_items = [
  { key: "import",        icon: "fa-cloud-arrow-down", tone: "primary"   },
  { key: "achievements",  icon: "fa-trophy",           tone: "accent"    },
  { key: "challenges",    icon: "fa-calendar-days",    tone: "secondary" },
  { key: "progress",      icon: "fa-arrow-trend-up",   tone: "primary"   },
  { key: "communities",   icon: "fa-users",            tone: "secondary" },
  { key: "seasonal",      icon: "fa-award",            tone: "accent"    },
  { key: "goals",         icon: "fa-bullseye",         tone: "secondary" },
  { key: "leaderboards",  icon: "fa-chart-simple",     tone: "primary"   }
] %>

<% feature_tone = {
  "primary"   => { bg: "bg-primary/10",   fg: "text-primary"   },
  "secondary" => { bg: "bg-secondary/10", fg: "text-secondary" },
  "accent"    => { bg: "bg-accent/10",    fg: "text-accent"    }
} %>

<% challenge_cards = [
  { key: "daily",    icon: "fa-bolt",   bg: "bg-accent",    fg: "text-accent-foreground"    },
  { key: "weekly",   icon: "fa-bullseye", bg: "bg-primary",  fg: "text-primary-foreground"   },
  { key: "seasonal", icon: "fa-sun",    bg: "bg-secondary", fg: "text-secondary-foreground" }
] %>

<% challenge_types = [
  { key: "daily",    icon: "fa-clock",      tone: "accent"    },
  { key: "weekly",   icon: "fa-fire",       tone: "primary"   },
  { key: "seasonal", icon: "fa-snowflake",  tone: "secondary" }
] %>

<%# Full-bleed wrapper: breaks out of the layout's max-w-4xl <main> %>
<div class="-mt-6 w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] bg-background text-foreground">

  <%# Hero %>
  <section class="relative overflow-hidden bg-linear-to-br from-primary/5 via-background to-secondary/5 py-20 md:py-32">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-secondary/10 blur-3xl"></div>
    </div>

    <div class="container relative mx-auto px-4 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-sm font-medium text-accent mb-6">
            <i class="fa-solid fa-bolt"></i>
            <span><%= t("home.hero.badge") %></span>
          </div>

          <h1 class="text-balance text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
            <%= t("home.hero.headline_lead") %>
            <span class="text-primary"><%= t("home.hero.headline_accent") %></span>
          </h1>

          <p class="mt-6 text-pretty text-lg text-muted-foreground max-w-xl mx-auto lg:mx-0">
            <%= t("home.hero.subheadline") %>
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <% if user_signed_in? %>
              <%= link_to t("home.hero.cta_authenticated"), challenges_path,
                    class: "inline-flex items-center justify-center bg-primary text-primary-foreground hover:bg-primary-hover transition px-8 py-3 rounded-lg font-semibold" %>
            <% else %>
              <%= link_to t("home.hero.cta_primary"), new_user_registration_path,
                    class: "inline-flex items-center justify-center bg-primary text-primary-foreground hover:bg-primary-hover transition px-8 py-3 rounded-lg font-semibold" %>
              <%= link_to t("home.hero.cta_secondary"), challenges_path,
                    class: "inline-flex items-center justify-center border-2 border-primary text-primary hover:bg-primary/10 transition px-8 py-3 rounded-lg font-semibold" %>
            <% end %>
          </div>

          <div class="mt-12 grid grid-cols-3 gap-8">
            <div class="text-center lg:text-left">
              <div class="text-3xl font-bold text-primary"><%= t("home.hero.stats.athletes_value") %></div>
              <div class="text-sm text-muted-foreground"><%= t("home.hero.stats.athletes_label") %></div>
            </div>
            <div class="text-center lg:text-left">
              <div class="text-3xl font-bold text-secondary"><%= t("home.hero.stats.workouts_value") %></div>
              <div class="text-sm text-muted-foreground"><%= t("home.hero.stats.workouts_label") %></div>
            </div>
            <div class="text-center lg:text-left">
              <div class="text-3xl font-bold text-accent"><%= t("home.hero.stats.challenges_value") %></div>
              <div class="text-sm text-muted-foreground"><%= t("home.hero.stats.challenges_label") %></div>
            </div>
          </div>
        </div>

        <div class="relative flex justify-center">
          <div class="relative">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-72 w-72 md:h-96 md:w-96 rounded-full border-2 border-primary/20 animate-pulse"></div>
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-56 w-56 md:h-80 md:w-80 rounded-full border-2 border-secondary/30"></div>
            </div>

            <div class="relative z-10 flex items-center justify-center h-72 w-72 md:h-96 md:w-96">
              <%= image_tag "logo.png", alt: "Broken Wheels", class: "h-40 w-40 md:h-56 md:w-56 drop-shadow-2xl object-cover rounded-full" %>
            </div>

            <div class="absolute top-4 right-0 md:top-8 md:right-4 bg-background shadow-lg rounded-xl p-3 flex items-center gap-2">
              <i class="fa-solid fa-trophy text-accent"></i>
              <span class="text-sm font-medium text-foreground"><%= t("home.hero.badge_achievement") %></span>
            </div>

            <div class="absolute bottom-4 left-0 md:bottom-8 md:left-4 bg-background shadow-lg rounded-xl p-3 flex items-center gap-2">
              <i class="fa-solid fa-users text-secondary"></i>
              <span class="text-sm font-medium text-foreground"><%= t("home.hero.badge_joined") %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# Features %>
  <section id="features" class="py-20 md:py-32 bg-background">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-sm font-semibold text-primary uppercase tracking-wider mb-4">
          <%= t("home.features.eyebrow") %>
        </span>
        <h2 class="text-balance text-3xl font-bold text-foreground sm:text-4xl lg:text-5xl">
          <%= t("home.features.title") %>
        </h2>
        <p class="mt-4 text-pretty text-lg text-muted-foreground">
          <%= t("home.features.subtitle") %>
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% feature_items.each do |item| %>
          <% tone = feature_tone[item[:tone]] %>
          <div class="group relative bg-card rounded-2xl p-6 border border-border hover:border-primary/50 hover:shadow-lg transition-all duration-300">
            <div class="inline-flex p-3 rounded-xl <%= tone[:bg] %> mb-4">
              <i class="fa-solid <%= item[:icon] %> <%= tone[:fg] %> text-xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-foreground mb-2">
              <%= t("home.features.items.#{item[:key]}.title") %>
            </h3>
            <p class="text-sm text-muted-foreground">
              <%= t("home.features.items.#{item[:key]}.body") %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# Challenges %>
  <section id="challenges" class="py-20 md:py-32 bg-muted/30">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block text-sm font-semibold text-secondary uppercase tracking-wider mb-4">
            <%= t("home.challenges.eyebrow") %>
          </span>
          <h2 class="text-balance text-3xl font-bold text-foreground sm:text-4xl lg:text-5xl">
            <%= t("home.challenges.title") %>
          </h2>
          <p class="mt-4 text-pretty text-lg text-muted-foreground">
            <%= t("home.challenges.subtitle") %>
          </p>

          <div class="mt-8 space-y-4">
            <% challenge_types.each do |type| %>
              <% tone = feature_tone[type[:tone]] %>
              <div class="flex items-center gap-4">
                <div class="flex items-center justify-center h-12 w-12 rounded-full <%= tone[:bg] %>">
                  <i class="fa-solid <%= type[:icon] %> <%= tone[:fg] %> text-xl"></i>
                </div>
                <div>
                  <h4 class="font-semibold text-foreground"><%= t("home.challenges.types.#{type[:key]}.title") %></h4>
                  <p class="text-sm text-muted-foreground"><%= t("home.challenges.types.#{type[:key]}.body") %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="space-y-4">
          <% challenge_cards.each do |card| %>
            <div class="bg-card rounded-2xl p-6 border border-border hover:shadow-lg transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex items-start gap-4">
                  <div class="<%= card[:bg] %> p-3 rounded-xl">
                    <i class="fa-solid <%= card[:icon] %> <%= card[:fg] %> text-xl"></i>
                  </div>
                  <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                      <%= t("home.challenges.cards.#{card[:key]}.type") %>
                    </span>
                    <h4 class="text-lg font-semibold text-foreground mt-1">
                      <%= t("home.challenges.cards.#{card[:key]}.title") %>
                    </h4>
                    <p class="text-sm text-muted-foreground mt-1">
                      <%= t("home.challenges.cards.#{card[:key]}.body") %>
                    </p>
                  </div>
                </div>
              </div>
              <div class="flex items-center justify-between mt-4 pt-4 border-t border-border">
                <div class="flex items-center gap-4 text-sm text-muted-foreground">
                  <span><%= t("home.challenges.cards.#{card[:key]}.participants") %> <%= t("home.challenges.participants") %></span>
                  <span class="font-semibold text-accent"><%= t("home.challenges.cards.#{card[:key]}.reward") %></span>
                </div>
                <%= link_to t("home.challenges.join"), challenges_path,
                      class: "inline-flex items-center bg-primary text-primary-foreground hover:bg-primary-hover transition px-4 py-2 rounded-lg text-sm font-semibold" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%# Final CTA %>
  <section id="community" class="py-20 md:py-32 bg-linear-to-br from-primary via-primary/90 to-primary/80 relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-0 h-64 w-64 rounded-full bg-secondary/20 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 h-64 w-64 rounded-full bg-accent/20 blur-3xl"></div>
    </div>

    <div class="container relative mx-auto px-4 max-w-6xl">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-balance text-3xl font-bold text-primary-foreground sm:text-4xl lg:text-5xl">
          <%= t("home.cta.title") %>
        </h2>
        <p class="mt-6 text-pretty text-lg text-primary-foreground/80">
          <%= t("home.cta.body") %>
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <% t("home.cta.benefits").each do |benefit| %>
            <div class="flex items-center gap-2 text-primary-foreground/90">
              <i class="fa-solid fa-circle-check text-secondary"></i>
              <span class="text-sm"><%= benefit %></span>
            </div>
          <% end %>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <% if user_signed_in? %>
            <%= link_to challenges_path,
                  class: "inline-flex items-center justify-center bg-background text-primary hover:bg-background/90 transition px-8 py-3 rounded-lg font-semibold" do %>
              <%= t("home.hero.cta_authenticated") %>
              <i class="fa-solid fa-arrow-right ml-2"></i>
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path,
                  class: "inline-flex items-center justify-center bg-background text-primary hover:bg-background/90 transition px-8 py-3 rounded-lg font-semibold" do %>
              <%= t("home.cta.button") %>
              <i class="fa-solid fa-arrow-right ml-2"></i>
            <% end %>
            <%= link_to t("home.cta.button_secondary"), "#",
                  class: "inline-flex items-center justify-center border border-primary-foreground/30 text-primary-foreground hover:bg-primary-foreground/10 transition px-8 py-3 rounded-lg font-semibold" %>
          <% end %>
        </div>

        <p class="mt-6 text-sm text-primary-foreground/60">
          <%= t("home.cta.disclaimer") %>
        </p>
      </div>
    </div>
  </section>
</div>
