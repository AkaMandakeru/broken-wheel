<div class="max-w-md mx-auto py-12">
  <div class="bg-white dark:bg-neutral-800 border border-black/10 dark:border-white/10 rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-8 sm:p-8">
      <h2 class="text-2xl font-bold text-neutral-900 dark:text-white mb-6">Change your password</h2>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="relative gap-y-1.5">
          <div class="flex items-baseline justify-between">
            <%= f.label :password, "New password", class: "form-label" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-neutral-500 dark:text-neutral-400">(<%= @minimum_password_length %> characters minimum)</span>
            <% end %>
          </div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: "New password" %>
        </div>

        <div class="relative gap-y-1.5">
          <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "Confirm new password" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Change my password", class: "btn-primary w-full" %>
        </div>
      <% end %>

      <div class="mt-6">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
