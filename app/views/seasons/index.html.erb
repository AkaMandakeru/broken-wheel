<div class="pt-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= t("seasons.index.title") %></h1>
  <p class="text-gray-600 mb-6"><%= t("seasons.index.subtitle") %></p>

  <% if @active_seasons.any? %>
    <div class="space-y-4 mb-10">
      <% @active_seasons.each do |season| %>
        <% cover = season_image_source(season, resize: [ 1200, 320 ]) %>
        <%= link_to season_path(season), class: "block rounded-2xl overflow-hidden bg-white shadow-sm border border-gray-200 hover:shadow-md transition" do %>
          <%# No scrim here — the title sits in the white card below, so darkening
              the artwork would serve nothing. %>
          <% if cover %>
            <%= image_tag cover, alt: season.name, class: "h-32 w-full object-cover sm:h-40" %>
          <% else %>
            <div class="h-2 bg-linear-to-r <%= season_theme_classes(season.theme) %>"></div>
          <% end %>
          <div class="p-6">
            <div class="flex items-start justify-between">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-[#FC4C02]"><%= t("seasons.index.active") %></span>
                <h2 class="text-2xl font-extrabold text-gray-900 mt-1"><%= season.name %></h2>
                <% if season.starts_at && season.ends_at %>
                  <p class="text-sm text-gray-500 mt-1"><%= season.starts_at.strftime("%b %-d") %> – <%= season.ends_at.strftime("%b %-d, %Y") %></p>
                <% end %>
              </div>
              <i class="fa-solid fa-trophy text-3xl text-[#FC4C02]/70"></i>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 py-8"><%= t("seasons.index.empty") %></p>
  <% end %>

  <% if @past_seasons.any? %>
    <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= t("seasons.index.past") %></h2>
    <div class="space-y-3">
      <% @past_seasons.each do |season| %>
        <% thumb = season_image_source(season, resize: [ 96, 96 ]) %>
        <%= link_to season_path(season), class: "flex items-center gap-3 bg-white rounded-lg border border-gray-200 p-4 hover:shadow-md transition" do %>
          <% if thumb %>
            <%= image_tag thumb, alt: season.name, class: "h-10 w-10 shrink-0 rounded-lg object-cover" %>
          <% else %>
            <span class="h-10 w-10 shrink-0 rounded-lg bg-linear-to-br <%= season_theme_classes(season.theme) %>"></span>
          <% end %>
          <span class="flex-1 min-w-0 font-medium text-gray-900 truncate"><%= season.name %></span>
          <span class="text-sm text-gray-500 whitespace-nowrap"><%= season.ends_at&.strftime("%b %Y") %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
