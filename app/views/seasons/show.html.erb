<div class="pt-8">
  <%# Themed header. With a picture the title sits on the image over a scrim,
      which keeps it readable whatever was uploaded; without one it falls back
      to the gradient accent bar and a dark title. %>
  <% banner = season_image_source(@season, resize: [ 1600, 500 ]) %>
  <div class="rounded-2xl overflow-hidden bg-white border border-gray-200 shadow-sm mb-6">
    <% if banner %>
      <div class="relative h-44 sm:h-60">
        <%= image_tag banner, alt: @season.name, class: "absolute inset-0 h-full w-full object-cover" %>
        <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/25 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
          <h1 class="text-3xl font-extrabold text-white drop-shadow-md"><%= @season.name %></h1>
          <% if @season.slogan.present? %>
            <p class="text-sm italic text-white/85 mt-1 drop-shadow"><%= @season.slogan %></p>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="h-2.5 bg-linear-to-r <%= season_theme_classes(@season.theme) %>"></div>
    <% end %>

    <div class="p-6 sm:p-8">
      <div class="flex items-start justify-between gap-3">
        <div>
          <% unless banner %>
            <h1 class="text-3xl font-extrabold text-gray-900"><%= @season.name %></h1>
            <% if @season.slogan.present? %>
              <p class="text-sm italic text-gray-500 mt-1"><%= @season.slogan %></p>
            <% end %>
          <% end %>
          <% if @season.starts_at && @season.ends_at %>
            <p class="text-sm text-gray-500 <%= "mt-1" unless banner %>"><%= @season.starts_at.strftime("%b %-d") %> – <%= @season.ends_at.strftime("%b %-d, %Y") %></p>
          <% end %>
        </div>
        <div class="flex flex-col items-end gap-2 sm:flex-row sm:items-center">
          <% if @participation&.premium? %>
            <span class="text-xs px-2 py-1 rounded-full whitespace-nowrap bg-amber-100 text-amber-700 font-semibold">
              <i class="fa-solid fa-crown mr-1"></i><%= t("seasons.show.premium") %>
            </span>
          <% end %>
          <span class="text-xs px-2 py-1 rounded-full whitespace-nowrap <%= season_status_badge_class(@season.status) %>">
            <%= t("seasons.statuses.#{@season.status}", default: @season.status.capitalize) %>
          </span>
          <% if user_signed_in? %>
            <%= link_to strava_activities_workouts_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-[#FC4C02] px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-[#e04402] whitespace-nowrap" do %>
              <i class="fa-solid fa-cloud-arrow-down"></i>
              <%= t("seasons.show.import_workouts") %>
            <% end %>
          <% end %>
        </div>
      </div>
      <% if @season.description.present? %>
        <p class="text-gray-600 mt-3 max-w-2xl"><%= @season.description %></p>
      <% end %>
    </div>
  </div>

  <%# Your progress, and any XP waiting to be collected. Both sit inside one
      controller element so the claim animation can travel from a card to the bar. %>
  <% if @participation %>
    <div data-controller="xp-claim">
      <%= render "seasons/progress", season: @season, participation: @participation %>
      <% if @unclaimed_completions.any? %>
        <%= render "seasons/claims", season: @season, participation: @participation,
                   completions: @unclaimed_completions %>
      <% end %>
    </div>
  <% elsif !user_signed_in? %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 mb-6 text-center">
      <p class="text-gray-600 mb-3"><%= t("seasons.show.sign_in_prompt") %></p>
      <%= link_to t("seasons.show.sign_in"), new_user_session_path, class: "bg-[#FC4C02] text-white px-6 py-2.5 rounded-lg hover:bg-[#e04402] transition font-medium" %>
    </div>
  <% end %>

  <%# Battle pass track %>
  <% if @rewards_by_level.any? %>
    <%= render "seasons/battle_pass", season: @season, participation: @participation,
               rewards_by_level: @rewards_by_level, granted_reward_ids: @granted_reward_ids %>
  <% end %>

  <%# Today's dailies %>
  <% if @daily_assignments.present? %>
    <%= render "seasons/dailies", assignments: @daily_assignments, progress: @daily_progress %>
  <% end %>

  <%# Community goal %>
  <% if @community_goal %>
    <%= render "seasons/community_goal", goal: @community_goal %>
  <% end %>

  <div class="grid lg:grid-cols-2 gap-6">
    <div>
      <%# Challenges, grouped by category %>
      <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= t("seasons.show.challenges") %></h2>

      <% if @weekly_challenges.any? %>
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mt-4 mb-2">
          <i class="<%= season_category_icon("weekly") %> mr-1"></i><%= t("seasons.categories.weekly") %>
        </h3>
        <div class="space-y-3">
          <% @weekly_challenges.each do |sc| %>
            <%= render "seasons/challenge_card", season_challenge: sc,
                       mine: @my_challenge_progress[sc.challenge_id], participation: @participation %>
          <% end %>
        </div>
      <% end %>

      <% %w[monthly elite standard hidden].each do |category| %>
        <% items = @challenges_by_category[category] %>
        <% next if items.blank? %>
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mt-6 mb-2">
          <i class="<%= season_category_icon(category) %> mr-1"></i><%= t("seasons.categories.#{category}", default: category.humanize) %>
        </h3>
        <div class="space-y-3">
          <% items.each do |sc| %>
            <%= render "seasons/challenge_card", season_challenge: sc,
                       mine: @my_challenge_progress[sc.challenge_id], participation: @participation %>
          <% end %>
        </div>
      <% end %>

      <% if @season_challenges.empty? %>
        <p class="text-gray-500 text-sm"><%= t("seasons.show.no_challenges") %></p>
      <% end %>

      <%# Club / action objectives %>
      <% if @season_objectives.any? %>
        <h3 class="text-sm font-semibold text-gray-900 mt-6 mb-3"><%= t("seasons.show.objectives") %></h3>
        <div class="space-y-3">
          <% @season_objectives.each do |objective| %>
            <% done = @completed_objective_ids.include?(objective.id) %>
            <div class="flex items-center gap-3 bg-white rounded-lg border <%= done ? 'border-green-200' : 'border-gray-200' %> p-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= done ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-400' %>">
                <i class="fa-solid <%= objective.kind == 'join_club' ? 'fa-users' : 'fa-people-group' %>"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-gray-900"><%= objective.display_name %></p>
                <p class="text-xs text-gray-500"><%= objective.display_description %></p>
              </div>
              <span class="text-xs font-semibold whitespace-nowrap <%= done ? 'text-green-600' : 'text-accent' %>">
                <%= done ? t("seasons.show.completed") : "+#{objective.xp_reward} XP" %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <%# Legacy missions %>
      <% if @legacy_missions.any? %>
        <%= render "seasons/legacy_missions", missions: @legacy_missions,
                   completed_ids: @completed_objective_ids, completed_count: @legacy_completed_count %>
      <% end %>

      <%# Bonus reward tracks (legacy, completion tiers, medals, community) %>
      <% if @bonus_rewards.any? %>
        <h2 class="text-lg font-semibold text-gray-900 mb-3 mt-6"><%= t("seasons.show.bonus_rewards") %></h2>
        <div class="space-y-2">
          <% @bonus_rewards.each do |reward| %>
            <% unlocked = @granted_reward_ids.include?(reward.id) %>
            <div class="flex items-center gap-3 bg-white rounded-lg border <%= unlocked ? 'border-green-200' : 'border-gray-200' %> p-3">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= unlocked ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-400' %>">
                <i class="<%= unlocked ? 'fa-solid fa-circle-check' : season_reward_icon(reward) %>"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-gray-900 text-sm"><%= season_reward_label(reward) %></p>
                <p class="text-xs text-gray-500">
                  <%= t("seasons.unlock_kinds.#{reward.unlock_kind}", value: reward.unlock_value, default: reward.unlock_kind) %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid lg:grid-cols-2 gap-6 mt-6">
    <%# Leaderboards %>
    <%= render "seasons/leaderboard", season: @season, leaderboard: @leaderboard,
               rows: @leaderboard_rows, board: @board, participation: @participation, my_position: @my_position %>

    <%# Recent activity %>
    <div>
      <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= t("seasons.show.recent_activity") %></h2>
      <div class="space-y-2">
        <% @activities.each do |activity| %>
          <div class="bg-white rounded-lg border border-gray-200 p-3 text-sm text-gray-700">
            <% if activity.community? %>
              <span class="font-medium text-gray-900"><i class="fa-solid fa-earth-americas mr-1"></i><%= t("seasons.show.community") %></span>
            <% else %>
              <span class="font-medium text-gray-900"><%= activity.user.first_name %></span>
            <% end %>
            <%= season_activity_text(activity) %>
          </div>
        <% end %>
        <% if @activities.empty? %>
          <p class="text-gray-500 text-sm"><%= t("seasons.show.no_activity") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
